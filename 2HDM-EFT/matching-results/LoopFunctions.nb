Cell[BoxData[
 RowBox[{
  RowBox[{"GetLF", "[", "x_", "]"}], ":=", 
  RowBox[{"LF", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ToExpression", "[", 
       RowBox[{"\"\<m\>\"", "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<[]\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{
         RowBox[{"Length", "[", "x", "]"}], "-", "1"}]}], "}"}]}], "]"}], ",",
     "x"}], "]"}]}]], "Input",
