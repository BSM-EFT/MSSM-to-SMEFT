  Editable->False]], "Echo",ExpressionUUID->"d12b00dd-8542-4a5c-9654-\
f5556f52e68e"]
}, Open  ]],

Cell[TextData[{
 "Notice: The Lagrangian implemented in the \[OpenCurlyDoubleQuote]MSSM.m\
\[CloseCurlyDoubleQuote] model file is given in the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "45b9e3ac-d531-4936-92d5-b878dca4c10a"],
 " scheme with all SUSY restoring finite counterterms (which are relevant for \
a one-loop matching) obtained by the scheme change from ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["DR", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "60cfec44-64cf-4eb4-9857-9a61189c5fb5"],
 " to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "825c81f9-188e-4cce-af54-6e9bcf9f248c"],
 " already included."
}], "Text",ExpressionUUID->"a09a4090-57ed-4563-b441-35683e76a5b7"],

