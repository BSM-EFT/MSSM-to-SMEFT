Cell[BoxData[
 RowBox[{"\[ScriptCapitalL]MSSM", "//", "CheckLagrangian"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"ef2d58b6-3277-4f2b-a025-cf19aa10cafd"],

