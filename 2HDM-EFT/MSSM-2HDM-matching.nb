        "redefinitions", " ", "for", " ", "the", " ", "mapping", " ", "onto", 
        " ", "the", " ", "Warsaww", " ", 
        RowBox[{"basis", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ReductionIdentities", "->", "EvanescenceFree"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
