}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Remove divergences by renormalization, i.e., subtracting the poles in ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1dd45443-ee79-41ba-b139-e9556b634ba4"],
 ":"
}], "Text",ExpressionUUID->"e6d4c3cd-a70c-467b-bbbf-041a1e761b85"],

