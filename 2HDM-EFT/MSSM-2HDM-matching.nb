Cell[CellGroupData[{

Cell["Optional: Treatment of loop functions", "Subsection",
 CellChangeTimes->{{3.957880159359795*^9, 3.957880182686008*^9}, {
  3.957887350657723*^9, 
  3.957887368653161*^9}},ExpressionUUID->"12ec3830-5549-4b78-9402-\
2eaff7431d7c"],

Cell["\<\
The code below makes Matchete no longer evaluate single scale loop integrals, \
but keeps the corresponding loop functions (LF) in the output.\
\>", "Text",
 CellChangeTimes->{{3.957880186203049*^9, 3.957880261390628*^9}, {
  3.957969066061404*^9, 
  3.957969088628286*^9}},ExpressionUUID->"6b7fabee-04a7-4247-9b95-\
b3b9736e88e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DownValues", "[", "Matchete`PackageScope`MatchReduce", "]"}], "=", 
   RowBox[{
    RowBox[{"DownValues", "[", "Matchete`PackageScope`MatchReduce", "]"}], "/.", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RuleDelayed", "[", 
       RowBox[{"_LF", ",", "_"}], "]"}], "->", "Nothing"}], ")"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"619cfdd9-938e-4166-b1c4-b9e3685e5714"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Loading the MSSM", "Section",ExpressionUUID->"fd2e1902-e83e-4e84-a810-3426d3596ce6"],

Cell["Loading the MSSM model file:", "Text",
 CellChangeTimes->{{3.9507088309802437`*^9, 
  3.950708834546425*^9}},ExpressionUUID->"cf08cf17-f97c-42c5-af43-\
3d29b42b0931"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalL]MSSM", " ", "=", " ", 
    RowBox[{"LoadModel", "@", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
        "\"\<MSSM-2HDM.m\>\""}], "}"}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"change", " ", "path", " ", "if", " ", "required"}], " ", 
   "*)"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"977db4fd-231e-452b-b2f5-c24f7542a422"],

Cell[BoxData[
 InterpretationBox["\<\"Added new CG \\!\\(\\*RowBox[{\\\"cg1\\\"}]\\) with \
indices \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"adj\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}]}], \\\"}\\\"}]\\)\"\>",
  StringForm["Added new CG `1` with indices `2`", $CellContext`cg1, {
    $CellContext`SU2L[Matchete`fund], 
    $CellContext`SU2L[Matchete`adj], 
    $CellContext`SU2L[Matchete`fund]}],
  Editable->False]], "Echo",ExpressionUUID->"5b40574e-66dc-4168-bf34-\
ada6d3b22fc2"]
}, Open  ]],

Cell[TextData[{
 "Notice: \[LineSeparator] - The model file provides a Lagrangian that is \
supersymmetric only in dimensional reduction (",
 Cell[BoxData[
  FormBox[
   OverscriptBox["DR", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "637d9931-5edd-498d-9430-bed731e8433f"],
 "). \n - We have to convert to the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6122e9c0-f52b-455c-9a25-2db00d43282a"],
 " scheme (dimensional regularization) before the matching in Matchete.\n - \
This can be done automatically using the DR2MS function defined in \
\[OpenCurlyDoubleQuote]DR-MS_scheme-conversion.m\[CloseCurlyDoubleQuote]."
}], "Text",ExpressionUUID->"c36d45b8-7351-42fc-a4e1-c7a97e14113e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Get", "@", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<DR-MS_scheme-conversion.m\>\""}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"770bfec6-99cb-44fa-87fd-39e4a80ff0ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]MSSM", "=", 
   RowBox[{"DR2MS", "[", "\[ScriptCapitalL]MSSM", "]"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"c8c202ed-d482-4519-b95d-a95aa6e8dc83"],

