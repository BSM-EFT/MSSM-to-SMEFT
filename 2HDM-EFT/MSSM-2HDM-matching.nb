Cell[CellGroupData[{

Cell["One-loop matching", "Section",
 CellChangeTimes->{{3.95796718053684*^9, 
  3.957967184271521*^9}},ExpressionUUID->"7e99e8ee-2250-4e92-91cc-\
b1cce64d06e1"],

Cell["\<\
Perform matching up to one-loop level and dimension six in the power counting \
and group result by operators:\
\>", "Text",
 CellChangeTimes->{{3.957969341896715*^9, 3.957969361892521*^9}, {
  3.958065830458713*^9, 
  3.958065846209244*^9}},ExpressionUUID->"4719e540-429f-4675-b601-\
7a8405ab997e"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"CheckLagrangian", "[", 
   RowBox[{"\[ScriptCapitalL]MSSM", ",", 
    RowBox[{"DetailedOutput", "->", "True"}]}], "]"}], "*)"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"deb9ade5-ca9f-4327-86fe-59f5b1f7fba1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]matchX", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"GreensSimplify", "@", 
     RowBox[{"Match", "[", 
      RowBox[{"\[ScriptCapitalL]MSSM", ",", "\[IndentingNewLine]", 
       RowBox[{"EFTOrder", "->", "6"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LoopOrder", "->", "1"}]}], "\[IndentingNewLine]", "]"}]}]}]}],
   ";"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"fa9ab662-591c-49b0-84a2-1cd92270e6c5"],

Cell[BoxData["633.871365`"], "EchoTiming",ExpressionUUID->"eeb20a05-f087-4b3a-b8d3-fab801d4512d"]
}, Open  ]],

Cell["\<\
This ensures a manifestly Hermitian Lagrangian and is required on Matchete \
v0.3.0 and v0.3.1 (from v0.3.2 onwards this is performed automatically).
Notice: The EFT Lagrangian obtained by Match is Hermitian, however, due to \
some unidentified permutation symmetries of masses in loop functions, \
Matchete might not recognize this. The line below resolves this issue by \
making the result manifestly Hermitian.\
\>", "Text",ExpressionUUID->"6174270a-a4c6-43e1-b117-667aec00c916"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]match", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"GreensSimplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalL]matchX", "+", 
        RowBox[{"Bar", "[", "\[ScriptCapitalL]matchX", "]"}]}], ")"}], "/", 
      "2"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"042a95da-2a47-4451-b08e-4494e60e2cc1"],

Cell[BoxData["75.528222`"], "EchoTiming",ExpressionUUID->"37bc7cdb-3750-4d26-821b-f1ce58485d2a"]
}, Open  ]],

