Cell[CellGroupData[{

Cell["Mapping to the Warsaw basis", "Section",
 CellChangeTimes->{{3.9507108221852837`*^9, 
  3.9507108225300217`*^9}},ExpressionUUID->"8605de96-e1a3-4e53-9a11-\
5e067f6f42d0"],

Cell[TextData[{
 "In this section the MSSM one-loop matching results are mapped onto the \
Warsaw basis [",
 ButtonBox["1008.4884",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1008.4884"], None},
  ButtonNote->"https://arxiv.org/abs/1008.4884"],
 "]."
}], "Text",
 CellChangeTimes->{{3.950710831771027*^9, 3.950710867068186*^9}, {
  3.950711563305339*^9, 3.950711564065982*^9}, {3.950757527058096*^9, 
  3.950757558334069*^9}, {3.95796938165858*^9, 
  3.957969382182222*^9}},ExpressionUUID->"b2ed6d60-aa53-4c86-a985-\
8a782b264825"],

Cell["\<\
Notice:
When loading the SMEFT Lagrangian in the Warsaw basis, the names of the gauge \
couplings have to be chosen consistently w.r.t. the names chosen in the MSSM \
model file.\
\>", "Text",ExpressionUUID->"14ed9cc6-f968-4fc9-8017-a8ac224078e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]Warsaw", "=", 
   RowBox[{"LoadModel", "[", 
    RowBox[{"\"\<2HDMEFT\>\"", ",", "\[IndentingNewLine]", 
     RowBox[{"ModelParameters", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gs", "->", "g3"}], ",", 
        RowBox[{"gL", "->", "g2"}], ",", 
        RowBox[{"gY", "->", "g1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"SetModelOptions", "->", 
      RowBox[{"{", 
       RowBox[{"(*", " ", 
        RowBox[{
        "NiceForm", " ", "must", " ", "be", " ", "chosen", " ", 
         "consistently", " ", 
         RowBox[{"w", ".", "r", ".", "t", ".", " ", "NiceForm"}], " ", "of", 
         " ", "MSSM", " ", "gauge", " ", "couplings"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"DefineGaugeGroup", ",", "SU3c", ",", 
          RowBox[{"NiceForm", "->", 
           RowBox[{"{", 
            RowBox[{
            "\"\<\\!\\(\\*SubscriptBox[\\(g\\), \\(3\\)]\\)\>\"", ",", 
             "Default"}], "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"DefineGaugeGroup", ",", "SU2L", ",", 
          RowBox[{"NiceForm", "->", 
           RowBox[{"{", 
            RowBox[{
            "\"\<\\!\\(\\*SubscriptBox[\\(g\\), \\(2\\)]\\)\>\"", ",", 
             "Default"}], "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"DefineGaugeGroup", ",", "U1Y", ",", 
          RowBox[{"NiceForm", "->", 
           RowBox[{"{", 
            RowBox[{
            "\"\<\\!\\(\\*SubscriptBox[\\(g\\), \\(1\\)]\\)\>\"", ",", 
             "Default"}], "}"}]}]}], "}"}]}], "\[IndentingNewLine]", 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"5c4d3239-331a-4f09-8122-eb6946130f48"],

Cell["\<\
For simplicity, remove all Baryon-number\[Dash]violating terms which are not \
generated in the R-parity conserving MSSM:\
\>", "Text",
 CellChangeTimes->{{3.95071124711939*^9, 3.950711269617975*^9}, 
   3.95071195539872*^9, {3.950763613596453*^9, 3.950763657041662*^9}, {
   3.957969464647952*^9, 3.9579695261756697`*^9}, {3.957970081727567*^9, 
   3.957970082229741*^9}},ExpressionUUID->"e91a6b1f-52e2-468b-8f3c-\
dcd69829ff2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]Warsaw", "=", 
   RowBox[{"\[ScriptCapitalL]Warsaw", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{
        RowBox[{
        "c\[Nu]\[Nu]\[Phi]11", "|", "c\[Nu]\[Nu]\[Phi]22", "|", 
         "c\[Nu]\[Nu]\[Phi]12", "|", "cduu", "|", "cqqq", "|", "cqqu", "|", 
         "cduq"}], ",", "___"}], "]"}], "->", "0"}], "}"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"6f6cbef8-855d-4a8d-89f2-2ece457c78d6"],

Cell["\<\
The following sets all evanescent operators to zero in all intermediate steps \
of the calculation.\[LineSeparator]This can significantly speed up the \
following calculation. 
This is valid for the present example since there are no tree-level matching \
contributions and thus evanescent operator only start contributing at the \
two-loop level. \[LineSeparator]Notice, however, that subsequently one should \
not run another matching where a tree-level contribution is present in this \
kernel, since this will lead to wrong results.\
\>", "Text",ExpressionUUID->"6b041b73-4aa5-4693-9030-57554197c060"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EvaOp", "[", "___", "]"}], "=", "0"}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"5d1ca4d6-dda9-4071-ab53-1e8f44b99ab2"],

Cell["\<\
Map the Lagrangian obtained by the matching \[ScriptCapitalL]match onto the \
Warsaw basis Lagrangian \[ScriptCapitalL]Warsaw:\
\>", "Text",
 CellChangeTimes->{{3.9579699108623457`*^9, 3.957969939601561*^9}, {
  3.957970076271394*^9, 
  3.957970076821385*^9}},ExpressionUUID->"89a4ab4e-6410-4781-85b4-\
d09eaa42e8ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchingConditions", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"MapEffectiveCouplings", "[", 
     RowBox[{
     "\[ScriptCapitalL]match", ",", "\[ScriptCapitalL]Warsaw", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"EOMSimplify", "->", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Ensure", " ", "application", " ", "of", " ", "field", " ", 
        "redefinitions", " ", "for", " ", "the", " ", "mapping", " ", "onto", 
        " ", "the", " ", "Warsaww", " ", 
        RowBox[{"basis", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ReductionIdentities", "->", "EvanescenceFree"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ShiftRenCouplings", "->", "True"}], ",", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Replace", " ", "renormalizable", " ", "UV", " ", "couplings", " ", 
         "by", " ", "effective", " ", "low"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"couplings", ".", " ", 
          RowBox[{"[", 
           RowBox[{
           "See", " ", "Appendix", " ", "E", ".2", " ", "for", " ", "more", 
            " ", 
            RowBox[{"details", "."}]}], "]"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"AppendEffectiveCouplingsDefs", "->", "True"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Addes", " ", "definition", " ", "of", " ", "internally", " ", 
       "defined", " ", "couplings", " ", "to", " ", "the", " ", "end", " ", 
       "of", " ", "the", " ", "list", " ", "of", " ", "matching", " ", 
       "conditions"}], " ", "*)"}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"dcac1108-a31c-4850-8f22-55694494d7dc"],

Cell[CellGroupData[{

Cell[BoxData["\<\"The Lagrangian contains terms of lower power than dimension \
