Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mc", "=", "MatchingConditionsNotShiftedFinite"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Get", "@", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParentDirectory", "@", 
         RowBox[{"NotebookDirectory", "[", "]"}]}], ",", 
        "\"\<matching-results\>\"", ",", "\"\<Mathematica\>\"", ",", 
        "\"\<MSSM-matching-conditions_detailed_not-shifted.m\>\""}], "}"}], 
      "]"}]}], ";"}], "*)"}]}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"caaa68d0-fd19-406b-b050-89c65c2e8bcc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tmp", "=", 
    RowBox[{"Association", "@@", "mc"}]}], 
   RowBox[{"(*", "MatchingCondition", "*)"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"AssociateTo", "[", 
     RowBox[{"tmp", ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"mH", "[", "]"}], "2"], "->", 
       SuperscriptBox[
        RowBox[{"tmp", "[", 
         RowBox[{"mH", "[", "]"}], "]"}], "2"]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"KeyDropFrom", "[", 
     RowBox[{"tmp", ",", 
      RowBox[{"mH", "[", "]"}]}], "]"}], ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tmp", "=", 
    RowBox[{
     RowBox[{"EchoTiming", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"hbar", ",", 
            RowBox[{"_LF", "|", "_Log"}]}], "}"}], ",", 
          RowBox[{"(*", "Factor", "*)"}], "FullSimplify"}], "]"}], "&"}], "/@",
        "tmp"}], "]"}], "/.", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"c\[Gamma]", "[", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"s\[Gamma]", "[", "]"}], "2"]}], "->", "1"}], ")"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{"EchoTiming", "[", 
      RowBox[{"MySimplify2", "/@", "tmp"}], "]"}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{"SimplifyNonLF", "/@", "tmp"}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"Normal", "@", "tmp"}]}], ";"}], "\n", 
 RowBox[{"%", "//", "ByteCount"}]}], "Input",
 CellChangeTimes->{{3.934541137921943*^9, 3.93454122448318*^9}, {
