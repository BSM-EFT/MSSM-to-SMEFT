      "\[IndentingNewLine]", 
      RowBox[{"ShiftRenCouplings", "->", "False"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Replace", " ", "renormalizable", " ", "UV", " ", "couplings", " ", 
