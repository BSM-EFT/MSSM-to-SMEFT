Cell["\<\
This ensures a manifestly Hermitian Lagrangian and is required on Matchete \
v0.3.0 and v0.3.1 (from v0.3.2 onwards this is performed automatically).
Notice: The EFT Lagrangian obtained by Match is Hermitian, however, due to \
some unidentified permutation symmetries of masses in loop functions, \
Matchete might not recognize this. The line below resolves this issue by \
making the result manifestly Hermitian.\
\>", "Text",ExpressionUUID->"6174270a-a4c6-43e1-b117-667aec00c916"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"\[ScriptCapitalL]match", "=", 
    RowBox[{"EchoTiming", "@", 
     RowBox[{"GreensSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[ScriptCapitalL]matchX", "+", 
         RowBox[{"Bar", "[", "\[ScriptCapitalL]matchX", "]"}]}], ")"}], "/", 
       "2"}], "]"}]}]}], ";"}], "*)"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"a2e7023c-7e5e-48f9-a23b-981b4f406fb3"],

