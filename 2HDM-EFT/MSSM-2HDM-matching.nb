Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      FractionBox["1", "4"], 
      FractionBox["1", 
       SuperscriptBox[
        SubscriptBox["g", "1"], "2"]], 
      SuperscriptBox[
       SuperscriptBox["B", 
        StyleBox[
         TemplateBox[{"\[Mu]", "\[Nu]"},
          "RowDefault"],
         FontSize->10]], "2"]}]}], "-", 
    RowBox[{
     FractionBox["1", "4"], 
     FractionBox["1", 
      SuperscriptBox[
       SubscriptBox["g", "3"], "2"]], 
     SuperscriptBox[
