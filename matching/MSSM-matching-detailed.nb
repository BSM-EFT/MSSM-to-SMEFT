Cell[CellGroupData[{

Cell["\<\
Determine the matching conditions in the Warsaw basis (w/ shifting the \
renormalizable couplings)\
\>", "Subsection",ExpressionUUID->"7374b566-51c7-485c-93f3-f7d499ac58ec"],

Cell["\<\
Map the Lagrangian obtained from matching the MSSM to the Lagrangian of the \
Warsaw basis:\
\>", "Text",
 CellChangeTimes->{{3.950758331245627*^9, 3.950758354915819*^9}, {
  3.957971341721445*^9, 
  3.95797134226128*^9}},ExpressionUUID->"94efd16e-c013-4f79-8c62-\
383ccfc89a45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchingConditionsDetailed", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"MapEffectiveCouplings", "[", 
     RowBox[{
     "\[ScriptCapitalL]OnShell", ",", "\[ScriptCapitalL]WarsawMatchete", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"EOMSimplify", "->", "False"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Application", " ", "of", " ", "field", " ", "redefinitions", " ", 
         "not", " ", "required", " ", "here"}], ",", " ", 
        RowBox[{
         RowBox[{
         "as", " ", "both", " ", "the", " ", "matching", " ", "and", " ", 
          "the", " ", "Warsaw", " ", "basis", " ", "Lagrangian", " ", "haven",
           " ", "be", " ", "brought", " ", "to", " ", "the", " ", "same", " ",
           "minimal", " ", "on"}], "-", 
         RowBox[{"shell", " ", "form", " ", 
          RowBox[{"before", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ReductionIdentities", "->", "dDimensional"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "No", " ", "Fierz", " ", "identites", " ", "are", " ", "required", " ",
         "here", " ", "for", " ", "mapping", " ", "between", " ", "the", " ", 
        "two", " ", 
        RowBox[{"Lagrangians", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ShiftRenCouplings", "->", "True"}], " ", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Replace", " ", "renormalizable", " ", "UV", " ", "couplings", " ", 
         "by", " ", "effective", " ", "low"}], "-", 
        RowBox[{"energy", " ", 
         RowBox[{"couplings", ".", " ", 
          RowBox[{"[", 
           RowBox[{
           "See", " ", "Appendix", " ", "E", ".2", " ", "for", " ", "more", 
            " ", 
            RowBox[{"details", "."}]}], "]"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"AppendEffectiveCouplingsDefs", "->", "True"}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Addes", " ", "definition", " ", "of", " ", "internally", " ", 
       "defined", " ", "couplings", " ", "to", " ", "the", " ", "end", " ", 
       "of", " ", "the", " ", "list", " ", "of", " ", "matching", " ", 
       "conditions"}], " ", "*)"}], "\[IndentingNewLine]", "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"e0306241-b024-45d8-995c-46e936437869"],

Cell[BoxData["307.192753`"], "EchoTiming",ExpressionUUID->"05df9633-3383-4921-8b04-aa5d92bab229"]
}, Open  ]],

