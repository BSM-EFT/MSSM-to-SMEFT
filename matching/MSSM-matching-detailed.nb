4289f2c74c61"]
}, Open  ]],

Cell[TextData[{
 "Notice: The Lagrangian implemented in the \[OpenCurlyDoubleQuote]MSSM.m\
\[CloseCurlyDoubleQuote] model file is given in the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],ExpressionUUID->
  "ed58b087-93c8-4b55-ad57-72a3907f05e0"],
 " scheme with all SUSY-restoring finite counterterms (which are relevant for \
a one-loop matching) obtained by the scheme change from ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["DR", "_"], TraditionalForm]],ExpressionUUID->
  "56a2e844-6eb3-447b-8b41-12a484f2d489"],
 " to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],ExpressionUUID->
  "5a9ede9b-c8b3-4e7c-9216-f610cb54b127"],
 " already included."
}], "Text",ExpressionUUID->"7213bd79-7f40-401b-9cdf-cc511a59bb8f"],

