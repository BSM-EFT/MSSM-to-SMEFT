Cell["One-loop matching conditions", "Subsection",ExpressionUUID->"da8b9de1-f840-4bca-bee2-188263707bca"],

Cell["Turn matching conditions into an association:", "Text",ExpressionUUID->"d9d47cea-cf56-42d9-a996-f14d13b1e33a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"loopMC", "=", 
   RowBox[{
   "Association", "@@", "MatchingConditionsDetailedNotShiftedFinite"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"loopMC", "=", 
     RowBox[{"Association", "@@", "MatchingConditionsDetailedFinite"}]}], 
    ";"}], "*)"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "choose", " ", "this", " ", "for", " ", "the", " ", "shifted", " ", 
    "matching", " ", "conditions"}], " ", "*)"}]}]}], "Input",ExpressionUUID->\
"f2a2397f-473e-40f3-80d7-7d968a1b47b5"],

Cell["\<\
Group each matching conditions by loop functions (LF) and simplify couplings:\
\
\>", "Text",ExpressionUUID->"55d41ee9-2c08-4cd8-89cc-14c2c32e261c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"loopMC", "=", 
   RowBox[{
    RowBox[{"EchoTiming", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"hbar", ",", 
           RowBox[{"_LF", "|", "_Log"}]}], "}"}], ",", "FullSimplify"}], 
        "]"}], "&"}], "/@", "loopMC"}], "]"}], "/.", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"c\[Gamma]", "[", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"s\[Gamma]", "[", "]"}], "2"]}], "->", "1"}], ")"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"1ecc4d28-6db2-4d9b-a45d-f182f4fae90f"],

Cell[BoxData["97.192255`"], "EchoTiming",ExpressionUUID->"52e46ecb-680e-4214-9278-bb4ffbb9f5ef"]
}, Open  ]],

Cell["Return to lists:", "Text",ExpressionUUID->"faf8025e-75be-4315-a22f-cff0e57d83a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"loopMC", "=", 
   RowBox[{"Normal", "@", "loopMC"}]}], ";"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"dcedd6d3-81a5-4f51-bf45-5fe8f99b3a7c"],

