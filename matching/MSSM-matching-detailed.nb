Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"treeMC", "=", 
   RowBox[{"Table", "[", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"rule", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "->", 
      RowBox[{"FullSimplify", "@", 
       RowBox[{"Normal", "@", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"rule", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "/.", "treeMC"}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Coupling", "[", 
             RowBox[{"mH2", ",", 
              RowBox[{"{", "}"}], ",", "2"}], "]"}], ",", "0", ",", "1"}], 
           "}"}]}], "]"}]}]}]}], "\n", "\t", ",", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"rule", ",", 
       RowBox[{"treeMC", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"-", "2"}]}], "]"}], "]"}]}], "}"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"%", "//", "TableForm"}], "//", "NiceForm"}]}], "Input",
