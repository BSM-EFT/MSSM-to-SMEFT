Cell[BoxData[
 InterpretationBox["\<\"Added new CG \\!\\(\\*RowBox[{\\\"cg1\\\"}]\\) with \
indices \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"adj\\\", \\\"]\\\"}], \\\",\\\", RowBox[{\\\"SU2L\\\", \\\"[\\\", \
\\\"fund\\\", \\\"]\\\"}]}], \\\"}\\\"}]\\)\"\>",
  StringForm["Added new CG `1` with indices `2`", $CellContext`cg1, {
    $CellContext`SU2L[Matchete`fund], 
    $CellContext`SU2L[Matchete`adj], 
    $CellContext`SU2L[Matchete`fund]}],
  Editable->False]], "Echo",ExpressionUUID->"e6697ea7-03d5-4c47-8f1a-\
31a4840d399c"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"\[ScriptCapitalL]MSSM", "=", 
    RowBox[{"\[ScriptCapitalL]MSSM", "/.", 
     RowBox[{"DR2MS", "->", "Identity"}]}]}], ";"}], "*)"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"380e8870-b43f-43b5-aeb5-fcda8e3ed1d8"],

Cell[TextData[{
 "Notice: The Lagrangian implemented in the \[OpenCurlyDoubleQuote]MSSM.m\
\[CloseCurlyDoubleQuote] model file is given in the ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],ExpressionUUID->
  "81f5098a-837b-4d9e-97fa-f20f048c0a6d"],
 " scheme with all SUSY restoring finite counterterms (which are relevant for \
a one-loop matching) obtained by the scheme change from ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["DR", "_"], TraditionalForm]],ExpressionUUID->
  "b0cb6467-9652-45f3-92ff-f126f173eee8"],
 " to ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["MS", "_"], TraditionalForm]],ExpressionUUID->
  "a4e8dba1-9898-43d3-89ad-ae7f0758a4f6"],
 " already included."
}], "Text",ExpressionUUID->"c36d45b8-7351-42fc-a4e1-c7a97e14113e"],

