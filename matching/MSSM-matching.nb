Use 'PrintEffectiveCouplings' and 'ReplaceEffectiveCouplings' to recover \
explicit expressions.\"\>"], "Echo",ExpressionUUID->"872f3b4c-668a-403d-aa1c-\
94e50ac8e15a"],

Cell[BoxData["1171.150666`"], "EchoTiming",ExpressionUUID->"80c9fba9-6690-4a4e-8bef-285581bef258"]
}, Open  ]]
}, Open  ]],

