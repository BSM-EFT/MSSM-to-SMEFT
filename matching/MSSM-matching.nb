Cell["\<\
Determine a list of all the d=6 (or d=4) terms in the Warsaw basis:\
\>", "Text",
 CellChangeTimes->{{3.957971788274908*^9, 
  3.9579718064852457`*^9}},ExpressionUUID->"0e2fdcdf-f430-4ee1-9077-\
dd1f7124c011"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d6Terms", "=", 
   RowBox[{"List", "@@", 
    RowBox[{"SeriesEFT", "[", 
     RowBox[{"\[ScriptCapitalL]Warsaw", ",", 
      RowBox[{"EFTOrder", "->", 
       RowBox[{"{", "6", "}"}]}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d4Terms", "=", 
   RowBox[{"List", "@@", 
    RowBox[{"SeriesEFT", "[", 
     RowBox[{"\[ScriptCapitalL]Warsaw", ",", 
      RowBox[{"EFTOrder", "->", 
       RowBox[{"{", "4", "}"}]}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.957927109921712*^9, 3.957927155266596*^9}, {
  3.957932300718575*^9, 3.957932305896791*^9}, {3.957932353801114*^9, 
  3.957932354132678*^9}, {3.95793312245015*^9, 3.957933127609567*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"8abfaa27-405e-4d1d-b0a6-9817bc75d706"],

Cell["\<\
For every d=6 (or d=4) term in the Warsaw basis apply both matching \
conditions and subtract the results. If this is not vanishing print the \
corresponding coefficient:\
\>", "Text",
 CellChangeTimes->{{3.957971810252195*^9, 
  3.957971881707988*^9}},ExpressionUUID->"a5a4b237-3e2d-433c-8fdc-\
01a2003ccfdd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tmp", ",", " ", 
     RowBox[{"fail", "=", "False"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tmp", "=", 
        RowBox[{"SimplifyCouplings", "@", 
         RowBox[{"GreensSimplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"wc", "/.", "myMatchingConditionsFinite"}], ")"}], "-", 
            RowBox[{"(", 
             RowBox[{"wc", "/.", "myMatchingConditionsDetailedFinite"}], 
             ")"}]}], ",", 
           RowBox[{"ReductionIdentities", "->", "FourDimensional"}]}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"tmp", "=!=", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Echo", "@", 
           RowBox[{"NiceForm", "[", 
            RowBox[{"wc", "//", "RelabelIndices"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "@", 
           RowBox[{"NiceForm", "[", "tmp", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fail", "=", "True"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"wc", ",", 
        RowBox[{"RelabelIndices", "[", 
         RowBox[{"d6Terms", ",", 
          RowBox[{"Unique", "->", "True"}]}], "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{"fail", ",", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Check unsuccessful!\>\"", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Check successful.\>\"", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",\

 CellLabel->"In[25]:=",ExpressionUUID->"330d4856-888d-48bd-92a5-7cab2afcc058"],

Cell[BoxData["\<\"Check successful.\"\>"], "Print",
 CellLabel->
  "During evaluation of \
In[25]:=",ExpressionUUID->"0aa71cc2-9052-47e2-bdd0-7293f40c121d"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
