Cell["\<\
Compare the size of the expressions:
(The ByteCount does not have to agree exactly as flavor index symmetries \
allow for writing the same coefficient in different ways.)\
\>", "Text",ExpressionUUID->"986bde35-fd05-45d2-86e4-1f54329b2e95"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"myMatchingConditionsFinite", "=", 
   RowBox[{"MatchingConditionsFinite", "/.", 
    RowBox[{
     RowBox[{"Rule", "[", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{
         RowBox[{"cG2", "|", "cW2", "|", "cB2", "|", "cH2", "|", "CH2"}], ",",
          "___"}], "]"}], ",", "_"}], "]"}], "->", "Nothing"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ByteCount"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myMatchingConditionsDetailedFinite", "=", 
   RowBox[{"MatchingConditionsDetailedFinite", "/.", 
    RowBox[{
     RowBox[{"Rule", "[", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{
         RowBox[{"cG2", "|", "cW2", "|", "cB2", "|", "cH2", "|", "CH2"}], ",",
          "___"}], "]"}], ",", "_"}], "]"}], "->", "Nothing"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ByteCount"}]}], "Input",ExpressionUUID->"450579b9-f83c-\
4142-8582-52f11d69aa8c"],

Cell[BoxData["45998840"], "Output",
 CellLabel->"Out[20]=",ExpressionUUID->"b1867947-854e-4adf-8e86-385b00cd70bd"],

