       SpanSymmetric->False],
      StandardForm], 
     SubscriptBox[
      OverscriptBox["\[CapitalPhi]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox["i",
       FontSize->10]], 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         OverscriptBox["q", 
          StyleBox["_",
           FontWeight->Bold]], 
         StyleBox[
          TemplateBox[{"a", "j"},
           "RowDefault"],
          FontSize->10], 
         StyleBox["r",
          FontSize->10]], "\[CenterDot]", 
        SubscriptBox["P", "R"], "\[CenterDot]", 
        SuperscriptBox["u", 
         StyleBox[
          TemplateBox[{"a", "p"},
           "RowDefault"],
          FontSize->10]], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SuperscriptBox["\[CurlyEpsilon]", 
      StyleBox[
       TemplateBox[{"j", "i"},
        "RowDefault"],
       FontSize->10]]}], "-", 
    RowBox[{
     FractionBox["1", "72"], 
     SubscriptBox["c", "\[Gamma]"], 
     SuperscriptBox[
      OverscriptBox[
       SubscriptBox["y", "u"], 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox[
       TemplateBox[{"p", "r"},
        "RowDefault"],
       FontSize->10]], " ", 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["g", "1"], "2"], "+", 
         RowBox[{"27", 
          SuperscriptBox[
           SubscriptBox["g", "2"], "2"]}], "-", 
         RowBox[{"96", 
          SuperscriptBox[
           SubscriptBox["g", "3"], "2"]}]}], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SuperscriptBox["\[CapitalPhi]", 
      StyleBox["j",
       FontSize->10]], 
     FormBox[
      StyleBox[
       RowBox[{"(", 
        SubsuperscriptBox[
         OverscriptBox["u", 
          StyleBox["_",
           FontWeight->Bold]], 
         StyleBox["a",
          FontSize->10], 
         StyleBox["r",
          FontSize->10]], "\[CenterDot]", 
        SubscriptBox["P", "L"], "\[CenterDot]", 
        SuperscriptBox["q", 
         StyleBox[
          TemplateBox[{"a", "i", "p"},
           "RowDefault"],
          FontSize->10]], ")"}],
       SpanSymmetric->False],
      StandardForm], 
     SubscriptBox[
      OverscriptBox["\[CurlyEpsilon]", 
       StyleBox["_",
        FontWeight->Bold]], 
      StyleBox[
       TemplateBox[{"i", "j"},
        "RowDefault"],
       FontSize->10]]}]}], "StandardForm"], Matchete`NiceForm]], "Output",
 CellLabel->
  "Out[9]//NiceForm=",ExpressionUUID->"70a2fddc-0ac0-40a6-ab7d-181fe428306f"]
}, Open  ]],

Cell["\<\
Notice: \[LineSeparator]Below, the matching and reduction to the Warsaw basis \
is written in a compact form.
For illustration, a more detailed step-by-step discussion of the matching and \
operator reduction is presented in the notebook MSSM-matching-detailed.nb.\
\>", "Text",
 CellChangeTimes->{{3.95075660348979*^9, 3.950756692074267*^9}, {
  3.957969195905223*^9, 3.957969332802825*^9}, {3.9579694054945183`*^9, 
  3.957969405573742*^9}},ExpressionUUID->"7fcf22f6-b5d9-4252-9764-\
17db7c1e064d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["One-loop matching", "Section",
 CellChangeTimes->{{3.95796718053684*^9, 
  3.957967184271521*^9}},ExpressionUUID->"7e99e8ee-2250-4e92-91cc-\
b1cce64d06e1"],

Cell["\<\
Perform matching up to one-loop level and dimension six in the power counting \
and group result by operators:\
\>", "Text",
 CellChangeTimes->{{3.957969341896715*^9, 3.957969361892521*^9}, {
  3.958065830458713*^9, 
  3.958065846209244*^9}},ExpressionUUID->"4719e540-429f-4675-b601-\
7a8405ab997e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalL]match", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"CollectOperators", "@", 
     RowBox[{"Match", "[", 
      RowBox[{"\[ScriptCapitalL]MSSM", ",", "\[IndentingNewLine]", 
       RowBox[{"EFTOrder", "->", "6"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LoopOrder", "->", "1"}]}], "\[IndentingNewLine]", "]"}]}]}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.950712351307383*^9, 3.950712371439701*^9}, {
  3.950712452684945*^9, 3.950712454799845*^9}, {3.950758543607189*^9, 
  3.950758547969054*^9}, {3.958058876497031*^9, 3.958058879214*^9}, {
  3.958063287632105*^9, 3.958063290973777*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"fa9ab662-591c-49b0-84a2-1cd92270e6c5"],

Cell[BoxData["1137.089966`"], "EchoTiming",ExpressionUUID->"bbaa9315-043d-4d0a-a48e-642d95dd9c12"]
}, Open  ]],

