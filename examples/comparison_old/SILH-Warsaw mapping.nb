      SuperscriptBox[
       RowBox[{"FS", "[", 
        RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "2"]}], ",", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"CWB", "[", "]"}], "2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"CG", "[", 
         RowBox[{
          RowBox[{"gen", "@", 
           RowBox[{"SU2L", "[", "fund", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"J", ",", "i", ",", "j"}], "}"}]}], "]"}], 
        RowBox[{"H", "[", "j", "]"}]}], ")"}], 
      RowBox[{"FS", "[", 
       RowBox[{"W", ",", "\[Mu]", ",", "\[Nu]", ",", "J"}], "]"}], 
      RowBox[{"FS", "[", 
       RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CW", "[", "]"}], 
      RowBox[{"HermitianCD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], ",", 
        RowBox[{"H", "[", "j", "]"}]}], "]"}], 
