 RowBox[{
  RowBox[{"\[ScriptCapitalL]SILH", "=", 
   RowBox[{"Plus", "[", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"CGG", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      SuperscriptBox[
       RowBox[{"FS", "[", 
        RowBox[{"G", ",", "\[Mu]", ",", "\[Nu]", ",", "a"}], "]"}], "2"]}], 
     ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CWW", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
