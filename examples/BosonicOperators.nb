Cell["We can now map these results onto the Warsaw basis:", "Text",ExpressionUUID->"c982c2b9-e654-46d2-8998-9c6873546cbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"mcSelfEnergy", "=", 
   RowBox[{"EchoTiming", "@", 
    RowBox[{"MapEffectiveCouplings", "[", 
     RowBox[{
      RowBox[{"\[ScriptCapitalL]SM", "+", "\[ScriptCapitalL]FFDD"}], ",", 
      "\[ScriptCapitalL]Warsaw", ",", "\[IndentingNewLine]", "\t", 
      RowBox[{"ShiftRenCouplings", "->", "False"}], ",", 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"ReductionIdentities", "->", "FourDimensional"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"490449d1-f15b-48df-9db7-4984b7658f2a"],

