Cell[TextData[{
 "Comparing this result to our cross check above, we see that the entire \
discrepancy between our results and the ones in \
https://arxiv.org/abs/1512.03003v2 is due to the contributions from the \
operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox["W", "\[Mu]\[Nu]"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["D", "\[Rho]"], 
      SubscriptBox["W", "\[Rho]\[Nu]"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40afd36d-2158-4a9d-b321-e69e90fdad9a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["D", "\[Mu]"], 
      SuperscriptBox["B", "\[Mu]\[Nu]"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["D", "\[Rho]"], 
      SubscriptBox["B", "\[Rho]\[Nu]"]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0657f264-827e-4af4-84c7-b7cf7a74592e"],
 ", which have been missed in https://arxiv.org/abs/1512.03003v2."
}], "Text",ExpressionUUID->"fa798daa-cd09-4dc0-8da4-b27ef85a16be"]
}, Closed]]
}, Open  ]]
}, Open  ]]
},
