Cell[CellGroupData[{

Cell["Wilson coefficient results", "Subsection",ExpressionUUID->"8d36668a-64f9-4e45-b4fb-6c683173bcb9"],

Cell[TextData[{
 "We consider the following list of Warsaw basis Wilson coefficients for the \
comparison:\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", "H"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "418b6605-733c-46b7-abc7-11af57479065"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", 
    RowBox[{"H", "\[Placeholder]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3aa2ba55-aed7-491c-a9cd-f76a3e54a25f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", "HD"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "356f88ea-712b-40db-8b97-c85333d45f90"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", "HW"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51db32bc-4b31-400c-8023-153154ab6475"],
