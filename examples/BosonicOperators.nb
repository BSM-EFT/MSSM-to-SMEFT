Cell["\<\
Select the Wilson coefficients considered in the example above:\
\>", "Text",ExpressionUUID->"56fadc3f-f546-4b7d-be79-02d861056c84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"relevantTerms", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"mcSelfEnergy", ",", 
     RowBox[{"x_", "/;", 
      RowBox[{"MatchQ", "[", 
       RowBox[{
        RowBox[{"First", "[", "x", "]"}], ",", 
        RowBox[{"Coupling", "[", 
         RowBox[{
          RowBox[{
          "cHBox", "|", "cHD", "|", "cHu", "|", "cHq1", "|", "cHq3", "|", 
           "cH", "|", "cuH"}], ",", "___"}], "]"}]}], "]"}]}], ",", "1"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"4c735c1e-c8d2-4208-982b-cd5b97b3a2fb"],

Cell["\<\
Set the down Yukawa to zero, change to third generation indices, and remove \
the FlavorSum symbol. In addition, evaluate the loop functions and Simplify \
the result:\
\>", "Text",ExpressionUUID->"6c3a6d76-4a31-4423-be47-b492e3b8f2cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"relevantTermsSimplified", "=", 
   RowBox[{"FullSimplify", "@", 
    RowBox[{"EvaluateLoopFunctions", "[", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"relevantTerms", "/.", 
        RowBox[{
         RowBox[{"Coupling", "[", 
          RowBox[{"yd", ",", "___"}], "]"}], "->", "0"}]}], "/.", 
       RowBox[{
        RowBox[{"Index", "[", 
         RowBox[{"n_", ",", "Flavor"}], "]"}], "->", 
        RowBox[{"Index", "[", 
         RowBox[{"3", ",", "Flavor"}], "]"}]}]}], "/.", 
      RowBox[{"_FlavorSum", "->", "1"}]}], "\n", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"%", "//", "TableForm"}], "//", "NiceForm"}]}], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"8fa10a11-a414-481e-99fc-59fdda356ee9"],

