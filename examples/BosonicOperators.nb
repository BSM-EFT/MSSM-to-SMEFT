Cell[CellGroupData[{

Cell["Map the SILH Lagrangian onto the Warsaw basis", "Section",ExpressionUUID->"79b7cecb-2a35-47b4-a004-8d760cd139b6"],

Cell[TextData[{
 "This mapping can be performed using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"MapEffectiveCouplings", "[", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "1"], ",", 
     SubscriptBox["\[ScriptCapitalL]", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "292e9703-d98f-4243-aab1-ec505d611173"],
 "] which relates the (redundant) operators in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalL]", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9027835f-b662-4f4d-bab8-147a3b281e36"],
 " to the minimal basis given as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalL]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "936852fe-933c-478e-a62a-07a8ac37507d"],
 ". The option ReductionIdentities \[Rule] FourDimensional is used to improve \
performance here, since for the specific reduction considered here there is \
no difference between working ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d912884c-dc08-4675-9587-11896555becd"],
 " and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "=", 
    RowBox[{"4", "-", 
