        RowBox[{
         RowBox[{"c4\[Gamma]", "[", "]"}], "->", 
         RowBox[{"Cos", "[", 
          RowBox[{"4", "\[Gamma]"}], "]"}]}]}], "}"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"Cos", "[", 
