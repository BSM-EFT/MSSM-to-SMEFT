Cell["\<\
Here we compute the log-type supertraces for the stop quarks, which contain \
corrections to the self-energy of gauge fields but also the corresponding \
higher-power operators, which are the ones we are interested in.\
\>", "Text",ExpressionUUID->"6350a631-17e3-4b8a-91d9-4d7934a59956"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"selfEnergy", "=", 
   RowBox[{"EchoTiming", "[", 
    RowBox[{
     RowBox[{"CovariantLoop", "[", 
      RowBox[{"\[ScriptCapitalL]MSSM", ",", 
       RowBox[{"{", "qt", "}"}]}], "]"}], "+", 
     RowBox[{"CovariantLoop", "[", 
      RowBox[{"\[ScriptCapitalL]MSSM", ",", 
       RowBox[{"{", "ut", "}"}]}], "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"02394d12-4cd2-48c6-ada2-6ae1fd688e95"],

Cell[BoxData["53.974859`"], "EchoTiming",ExpressionUUID->"38efbed3-e475-4c95-89c7-17630ae84353"]
}, Open  ]],

Cell["\<\
We are only interested in pure gauge operators here and can therefore set all \
fields to zero, retaining only FieldStrength tensors.\
\>", "Text",ExpressionUUID->"96d69aa6-e3af-41b2-80ba-aec2c6464802"],

