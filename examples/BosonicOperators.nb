Cell[CellGroupData[{

Cell["Mapping onto the Warsaw basis", "Chapter",ExpressionUUID->"757929b1-e021-43bb-97e9-e84b1c2ee1df"],

Cell["\<\
First, we need to relate the redundant and incomplete SILH operator set \
employed by https://arxiv.org/abs/1512.03003 onto the non-redundant and \
compete Warsaw basis used here.\
\>", "Text",ExpressionUUID->"5066c3da-a34d-4446-8e46-68ab07f86ac9"],

Cell[CellGroupData[{

Cell["Defining the SILH Lagrangian", "Section",ExpressionUUID->"deb53c15-26b8-4b29-b84c-a14f3307913f"],

Cell["Following Tab. 2 of https://arxiv.org/abs/1512.03003.", "Text",ExpressionUUID->"e31eadb7-c6f2-43c0-b6d1-0080d5db958a"],

Cell[CellGroupData[{

Cell["Auxiliary definitions", "Subsection",ExpressionUUID->"030d6f4a-bc83-401e-b8de-0acfea1d1b41"],

Cell["\<\
Define a Hermitian version of the Covariant derivative acting on 2 fields:\
\>", "Text",ExpressionUUID->"1cfe8a4f-c04b-4ea5-a35c-5e99c2dcc1c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HermitianCD", "[", 
    RowBox[{"ind_", ",", "term1_", ",", "term2_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"I", " ", "term1", " ", 
     RowBox[{"CD", "[", 
      RowBox[{"ind", ",", "term2"}], "]"}]}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"CD", "[", 
      RowBox[{"ind", ",", "term1"}], "]"}], " ", "term2"}]}]}], 
  ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"065e6f28-bcdc-485d-ad05-a43bac1bab32"]
}, Open  ]],

