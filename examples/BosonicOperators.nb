43bbbed19e47"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"ht", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(h\), \(t\)]\)\>\""}]}],
   "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Xt", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(X\), \(t\)]\)\>\""}]}],
   "]"}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"8499bd59-ff0b-4210-ac42-3b66f8bf9c97"]
