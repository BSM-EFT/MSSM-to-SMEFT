Cell[TextData[{
 "For each coefficient, we plug in our matching conditions, remove all loop \
functions (LF) that depend on the masses that have been set to \[Infinity] by \
https://arxiv.org/abs/1512.03003, and neglect the Yukawas and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "789c9285-10c3-4540-94e6-d1821aa7495c"],
 "-terms of the down-type squarks."
}], "Text",ExpressionUUID->"c9b82dbb-2a2a-451c-938c-2c0d61bf37ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReduceMatchingConditions", "[", "wc_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "expr", "}"}], ",", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"apply", " ", "matching", " ", "condition"}], " ", "*)"}], "\n",
      "\t", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{"wc", "/.", "mc"}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"neglect", " ", "down"}], "-", 
        RowBox[{"type", " ", "Yukawa", " ", "and", " ", "a"}], "-", "terms"}],
        " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"Coupling", "[", 
          RowBox[{
           RowBox[{"yd", "|", "ad"}], ",", "___"}], "]"}], "->", "0"}]}]}], 
      ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Set", " ", "all", " ", "loop", " ", "functions", " ", "to", " ", 
        "zero", " ", "that", " ", "depend", " ", "on", " ", "mass", " ", "of",
         " ", "particles", " ", "that", " ", "are", " ", "ignored", " ", 
        "here"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"LF", "[", "arg___", "]"}], "/;", 
          RowBox[{"!", 
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "arg", "}"}], ",", "neglectedMassPattern", ",", 
             "All"}], "]"}]}]}], "->", "0"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"due", " ", "to", " ", "its", " ", "non"}], "-", 
         RowBox[{"vanishing", " ", "tree"}], "-", 
         RowBox[{"level", " ", "contribution"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "heavy", " ", "Higgs", " ", "can", " ", "contribute", 
          " ", "to", " ", "the", " ", "one"}], "-", 
         RowBox[{
         "loop", " ", "matching", " ", "conditions", " ", "also", " ", 
          "through", " ", "external", " ", "legs", " ", "with", " ", "EOM", 
          " ", "insertions", " ", "instead", " ", "of", " ", "only", " ", 
          RowBox[{"loops", ".", " ", "Hence"}], " ", "we", " ", "have", " ", 
          "to", " ", "set", " ", "its", " ", "mass", " ", "to", " ", 
          RowBox[{"\[Infinity]", "."}]}]}]}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"Limit", "[", 
        RowBox[{"expr", ",", 
         RowBox[{
          RowBox[{"m\[CapitalPhi]", "[", "]"}], "->", "\[Infinity]"}]}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "set", " ", "all", " ", "remeining", " ", "flavor", " ", "indices", 
        " ", "to", " ", "the", " ", "third", " ", "generation"}], " ", "*)"}],
       "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"_", ",", "Flavor"}], "]"}], "->", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "remove", " ", "the", " ", "FlavorSum", " ", "object", " ", 
        "introduced", " ", "by", " ", "Matchete"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{"_FlavorSum", "->", "1"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"map", " ", "to", " ", "the", " ", "notation", " ", 
        RowBox[{"of", " ", "[", "1512.03003", "]"}]}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "//.", "mapNotation"}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "set", " ", "the", " ", "remaining", " ", "couplings", " ", 
        "proportional", " ", "to", " ", "the", " ", "Higgsino", " ", "mass", 
        " ", "to", " ", "zero"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"\[Mu]t", "[", "]"}], "->", "0"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"evaluate", " ", "all", " ", "loop", " ", "functions"}], " ", 
       "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"EvaluateLoopFunctions", "[", "expr", "]"}]}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"318679cf-1427-4d04-bf86-3f351c3cc17e"],

