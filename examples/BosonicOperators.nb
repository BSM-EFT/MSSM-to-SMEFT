Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[GothicC]B", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Xt", "[", "]"}], "2"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "8"}], 
         SuperscriptBox[
          RowBox[{"mqt", "[", "3", "]"}], "2"], 
         SuperscriptBox[
          RowBox[{"mut", "[", "3", "]"}], "2"]}], "-", 
