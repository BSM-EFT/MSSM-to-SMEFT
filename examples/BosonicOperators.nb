Cell[CellGroupData[{

Cell["Mapping rule for these new couplings", "Subsubsection",ExpressionUUID->"00f52e5b-9b83-4932-948c-1d4e0b7972f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mapNotation", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"yu", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      FractionBox[
       RowBox[{"ht", "[", "]"}], 
       RowBox[{"s\[Gamma]", "[", "]"}]]}], ",", 
     RowBox[{
      RowBox[{"au", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      RowBox[{
       RowBox[{"yu", "[", 
        RowBox[{"3", ",", "3"}], "]"}], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"Xt", "[", "]"}], 
          RowBox[{"ht", "[", "]"}]], "+", 
         RowBox[{
          RowBox[{"\[Mu]t", "[", "]"}], 
          FractionBox[
           RowBox[{"c\[Gamma]", "[", "]"}], 
           RowBox[{"s\[Gamma]", "[", "]"}]]}]}], ")"}]}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"d710639c-7154-45a7-a9ec-26dba8d0a8e7"]
