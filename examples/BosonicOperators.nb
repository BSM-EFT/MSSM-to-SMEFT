Cell[CellGroupData[{

Cell["SILH Lagrangian", "Subsection",ExpressionUUID->"999c4da6-7f95-457a-893a-e8074cfc6a9c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]SILH", "=", 
   RowBox[{"Plus", "[", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"CGG", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      SuperscriptBox[
       RowBox[{"FS", "[", 
        RowBox[{"G", ",", "\[Mu]", ",", "\[Nu]", ",", "a"}], "]"}], "2"]}], 
     ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CWW", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      SuperscriptBox[
       RowBox[{"FS", "[", 
        RowBox[{"W", ",", "\[Mu]", ",", "\[Nu]", ",", "J"}], "]"}], "2"]}], 
     ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CBB", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      SuperscriptBox[
       RowBox[{"FS", "[", 
        RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}], "2"]}], ",", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"CWB", "[", "]"}], "2", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"CG", "[", 
         RowBox[{
          RowBox[{"gen", "@", 
           RowBox[{"SU2L", "[", "fund", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"J", ",", "i", ",", "j"}], "}"}]}], "]"}], 
        RowBox[{"H", "[", "j", "]"}]}], ")"}], 
      RowBox[{"FS", "[", 
       RowBox[{"W", ",", "\[Mu]", ",", "\[Nu]", ",", "J"}], "]"}], 
      RowBox[{"FS", "[", 
       RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CW", "[", "]"}], 
      RowBox[{"HermitianCD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], ",", 
        RowBox[{"H", "[", "j", "]"}]}], "]"}], 
      RowBox[{"CG", "[", 
       RowBox[{
        RowBox[{"gen", "@", 
         RowBox[{"SU2L", "[", "fund", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"J", ",", "i", ",", "j"}], "}"}]}], "]"}], 
      RowBox[{"CD", "[", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{"FS", "[", 
         RowBox[{"W", ",", "\[Mu]", ",", "\[Nu]", ",", "J"}], "]"}]}], 
       "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CB", "[", "]"}], 
      FractionBox["1", "2"], 
      RowBox[{"HermitianCD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], ",", 
        RowBox[{"H", "[", "i", "]"}]}], "]"}], 
      RowBox[{"CD", "[", 
       RowBox[{"\[Nu]", ",", 
        RowBox[{"FS", "[", 
         RowBox[{"B", ",", "\[Mu]", ",", "\[Nu]"}], "]"}]}], "]"}]}], ",", 
     "\n", "\t", 
     RowBox[{
      FractionBox[
       RowBox[{"CH", "[", "]"}], "2"], 
      RowBox[{"CD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{
         RowBox[{"Bar", "@", 
          RowBox[{"H", "[", "i", "]"}]}], 
         RowBox[{"H", "[", "i", "]"}]}]}], "]"}], 
      RowBox[{"CD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{
         RowBox[{"Bar", "@", 
          RowBox[{"H", "[", "j", "]"}]}], 
         RowBox[{"H", "[", "j", "]"}]}]}], "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"CT", "[", "]"}], "2"]}], 
      RowBox[{"HermitianCD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], ",", 
        RowBox[{"H", "[", "i", "]"}]}], "]"}], 
      RowBox[{"HermitianCD", "[", 
       RowBox[{"\[Mu]", ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "j", "]"}]}], ",", 
        RowBox[{"H", "[", "j", "]"}]}], "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CR", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"CD", "[", 
         RowBox[{"\[Mu]", ",", 
          RowBox[{"Bar", "@", 
           RowBox[{"H", "[", "j", "]"}]}]}], "]"}], 
        RowBox[{"CD", "[", 
         RowBox[{"\[Mu]", ",", 
          RowBox[{"H", "[", "j", "]"}]}], "]"}]}], ")"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"CDD", "[", "]"}], 
      RowBox[{"CD", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Mu]", ",", "\[Mu]"}], "}"}], ",", 
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}]}], "]"}], 
      RowBox[{"CD", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "\[Nu]"}], "}"}], ",", 
        RowBox[{"H", "[", "i", "]"}]}], "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"C6", "[", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "i", "]"}]}], 
        RowBox[{"H", "[", "i", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "j", "]"}]}], 
        RowBox[{"H", "[", "j", "]"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Bar", "@", 
         RowBox[{"H", "[", "k", "]"}]}], 
        RowBox[{"H", "[", "k", "]"}]}], ")"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"%", "//", "NiceForm"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"fb5d6676-4b0b-4771-ba1a-0750d11e04fc"],

