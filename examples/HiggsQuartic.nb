Cell[CellGroupData[{

Cell["Translate to notation of 1407.4081", "Subsection",ExpressionUUID->"3b73bf90-9fd0-47cc-8f59-08feba650945"],

Cell["\<\
The expression is simplified by grouping it by loop functions (LF).\
\>", "Text",ExpressionUUID->"50f585e0-f802-44ce-a570-2c33cb425dcb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"lambdaTOP", "/.", "GUTnorm"}], "/.", "TOPterms"}], ",", 
     "_LF"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"c90fc5e3-c8db-4949-a648-2d02fe376152"]
}, Closed]],

Cell[CellGroupData[{

Cell["Adopting different \[Beta] definition of 1407.4081", "Subsection",ExpressionUUID->"9dfa136b-8328-4bf0-b9de-56aaf63df5e5"],

Cell["\<\
Notice that \[Gamma] in our conventions is defined in such a way as to \
diagonalize the scalar doublet mass matrix at tree-level, whereas \[Beta] in \
https://arxiv.org/abs/1407.4081v2 is defined such that this matric is \
diagonalized to all orders. Implementing the latter directly in Matchete is \
difficult. However, for the comparison it is equivalent to consider only \
terms where the heavy Higgs \[CapitalPhi] appears only inside loops and not \
in external lines, which are reduced into light particles through the \
equations of motion of \[CapitalPhi].\
\>", "Text",ExpressionUUID->"4bd6804a-4c8b-488f-bd61-c3397022bb94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"temporarily", " ", "rename", " ", "all", " ", 
    SubscriptBox["m", "\[CapitalPhi]"], " ", "appearing", " ", "inside", " ", 
    "loop", " ", "functions"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]OURS", "=", 
     RowBox[{"lambda", "/.", 
      RowBox[{"lf_LF", ":>", 
       RowBox[{"(", 
        RowBox[{"lf", "/.", 
         RowBox[{
          RowBox[{"m\[CapitalPhi]", "[", "]"}], "->", "MA"}]}], ")"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "set", " ", "all", " ", "remaining", " ", "instances", " ", "of", " ", 
      SubscriptBox["m", "\[CapitalPhi]"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "the"}], " ", "EOM", " ", 
        "contributions"}], ")"}], " ", "to", " ", "infinity"}], ",", " ", 
     RowBox[{"then", " ", "replace", " ", "back", " ", 
      SubscriptBox["m", "\[CapitalPhi]"], " ", "in", " ", "the", " ", "loop", 
      " ", "functions"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Lambda]OURS", "=", 
     RowBox[{
      RowBox[{"Limit", "[", 
       RowBox[{"\[Lambda]OURS", ",", 
        RowBox[{
         RowBox[{"m\[CapitalPhi]", "[", "]"}], "->", "\[Infinity]"}]}], "]"}],
       "/.", 
      RowBox[{"MA", "->", 
       RowBox[{"m\[CapitalPhi]", "[", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "evaluate", " ", "loop", " ", "functions", " ", "and", " ", "sort", " ", 
     "by", " ", "the", " ", "logarithimic", " ", "terms"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Lambda]OURS", "=", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"\[Lambda]OURS", "//", "EvaluateLoopFunctions"}], ",", 
       "_Log"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"0d71d3a3-ade1-4e87-bd0f-e7cea8c8f142"],

Cell["Print the result:", "Text",ExpressionUUID->"3f6de1e8-d13d-479f-a394-c6b60b437da5"],

