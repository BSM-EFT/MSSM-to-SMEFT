Cell[CellGroupData[{

Cell["Auxiliary definitions", "Subsection",ExpressionUUID->"a45dcd0d-740d-47c7-bcea-b046056a4b8a"],

Cell[CellGroupData[{

Cell["Defining couplings", "Subsubsection",ExpressionUUID->"fb83e570-b54a-41e9-9bc6-ad354113a1af"],

Cell["\<\
The couplings below are effective couplings defined on the fly by Matchete \
when performing the matching and mapping onto the Warsaw basis.
If the matching conditions are loaded in a new Mathematica kernel, as is \
assumed in this notebook, these couplings should be defined again with their \
correct properties.\
\>", "Text",ExpressionUUID->"acff655b-5911-42fa-bb73-2cb19f3441a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"define", " ", "effective", " ", "SMEFT", " ", "Yukawas"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cHqu", ",", 
     RowBox[{"Indices", "->", 
      RowBox[{"{", 
       RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", 
     RowBox[{
     "NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(c\), \(Hqu\)]\)\>\""}]}], 
    "]"}], "\n", 
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cHqd", ",", 
     RowBox[{"Indices", "->", 
      RowBox[{"{", 
       RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", 
     RowBox[{
     "NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(c\), \(Hqd\)]\)\>\""}]}], 
    "]"}], "\n", 
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cHle", ",", 
     RowBox[{"Indices", "->", 
      RowBox[{"{", 
       RowBox[{"Flavor", ",", "Flavor"}], "}"}]}], ",", 
     RowBox[{
     "NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(c\), \(Hle\)]\)\>\""}]}], 
    "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "define", " ", "effective", " ", "SMEFT", " ", "Higgs", " ", "mass", " ", 
     "parameter"}], " ", "*)"}], "\n", 
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cH2", ",", 
     RowBox[{"EFTOrder", "->", "2"}], ",", 
     RowBox[{
     "NiceForm", "->", 
      "\"\<\!\(\*SubscriptBox[\(c\), SuperscriptBox[\(H\), \(2\)]]\)\>\""}]}],
     "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"define", " ", "effective", " ", "SMEFT", " ", 
     RowBox[{"(", "weak", ")"}], " ", "gauge", " ", "couplings"}], " ", 
    "*)"}], "\n", 
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cB2", ",", 
     RowBox[{
     "NiceForm", "->", 
      "\"\<\!\(\*SubscriptBox[\(c\), SuperscriptBox[\(B\), \(2\)]]\)\>\""}]}],
     "]"}], "\n", 
   RowBox[{"DefineCoupling", "[", 
    RowBox[{"cW2", ",", 
     RowBox[{
     "NiceForm", "->", 
      "\"\<\!\(\*SubscriptBox[\(c\), SuperscriptBox[\(W\), \(2\)]]\)\>\""}]}],
     "]"}]}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"4cc8bdad-24ff-4bd4-aebb-07b05d611da9"],

Cell["\<\
Define Yukawa and a-term couplings from https://arxiv.org/abs/1407.4081v2\
\>", "Text",ExpressionUUID->"8d370618-e537-441c-b8d1-47f3298cf4c4"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"gt", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(g\), \(t\)]\)\>\""}]}],
   "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Xtt", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{
   "NiceForm", "->", 
    "\"\<\!\(\*SubscriptBox[OverscriptBox[\(X\), \(~\)], \(t\)]\)\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"b4e3f3f8-1b21-4bdc-9e30-16e86d8d0d3f"],

Cell["Define additional trigonometric function", "Text",ExpressionUUID->"f01ce316-d0ae-47ec-b61e-2ae24f855ded"],

Cell[BoxData[
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"c8\[Gamma]", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{
   "NiceForm", "->", 
    "\"\<\!\(\*SubscriptBox[\(c\), \(8  \[Gamma]\)]\)\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"b577b959-6b89-4598-97b0-55c324df0e6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Replacements of trigonometric functions for simplifications", \
"Subsubsection",ExpressionUUID->"5a894c52-f7f4-4689-bd3d-029e571631c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replTrig", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"s\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Sin", "[", "\[Gamma]", "]"}]}], ",", 
     RowBox[{
      RowBox[{"s2\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "\[Gamma]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"s4\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", "\[Gamma]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"c\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Cos", "[", "\[Gamma]", "]"}]}], ",", 
     RowBox[{
      RowBox[{"c2\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", "\[Gamma]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"c4\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", "\[Gamma]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"c8\[Gamma]", "[", "]"}], "->", 
      RowBox[{"Cos", "[", 
       RowBox[{"8", "\[Gamma]"}], "]"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"f6f3ab16-4bde-47fd-a815-dabade4e13ff"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Function for taking the limit of only top Yukawa couplings and ",
 Cell[BoxData[
  FormBox["top", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96e61b63-6a22-4f37-9e70-c38d9ab14e76"],
 " ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa4e30a9-f796-4d28-a79a-6a312ff51a0e"],
 "-terms"
}], "Subsubsection",ExpressionUUID->"7e5ada16-eaaf-4217-a4cc-44efe11ab4bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"YukawaLimit", "[", "arg_", "]"}], ":=", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"set", " ", "all", " ", "down"}], "-", 
     RowBox[{
     "type", " ", "and", " ", "lepton", " ", "Yukawas", " ", "or", " ", "a"}],
      "-", 
     RowBox[{"terms", " ", "to", " ", "zero"}]}], " ", "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"expr", "=", 
      RowBox[{"Expand", "[", 
       RowBox[{"arg", "/.", 
        RowBox[{
         RowBox[{"Coupling", "[", 
          RowBox[{
           RowBox[{"cHqd", "|", "cHle", "|", "ad", "|", "ae"}], ",", "___"}], 
          "]"}], "->", "0"}]}], "]"}]}], "}"}], "\n", "\t", ",", "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{"convert", " ", "expr", " ", "to", " ", "a", " ", "List"}], " ", 
     "*)"}], "\n", "\t", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "@", "expr"}], "===", "Plus"}], ",", 
       RowBox[{"expr", "=", 
        RowBox[{"List", "@@", "expr"}]}], ",", 
       RowBox[{"expr", "=", 
        RowBox[{"{", "expr", "}"}]}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"sum", " ", "over", " ", "all", " ", "terms"}], " ", "*)"}], 
     "\n", "\t", 
     RowBox[{"Sum", "[", "\n", "\t\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "determine", " ", "all", " ", "flavor", " ", "indices", " ", 
          "belonging", " ", "to", " ", "top", " ", "Yukawas", " ", 
          RowBox[{"(", "cHqu", ")"}], " ", "or", " ", "a"}], "-", 
         RowBox[{"terms", " ", 
          RowBox[{"(", "au", ")"}]}]}], ",", " ", 
        RowBox[{
        "then", " ", "replace", " ", "them", " ", "with", " ", "a", " ", "3", 
         "rd", " ", "generation", " ", "index"}]}], " ", "*)"}], "\n", "\t\t", 
      RowBox[{
       RowBox[{"term", "/.", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "->", 
             RowBox[{"Index", "[", 
              RowBox[{"3", ",", "Flavor"}], "]"}]}], ")"}], "&"}], "/@", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Cases", "[", 
            RowBox[{"term", ",", 
             RowBox[{
              RowBox[{"Coupling", "[", 
               RowBox[{
                RowBox[{"cHqu", "|", "au"}], ",", "inds_", ",", "_"}], "]"}], 
              ":>", "inds"}], ",", "All"}], "]"}]}]}], ")"}]}], "\n", "\t\t", 
       ",", "\n", "\t\t", 
       RowBox[{"{", 
        RowBox[{"term", ",", "expr"}], "}"}]}], "\n", "\t", "]"}]}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"59c4e633-92c4-48b2-9ae9-5997561a7971"],

Cell["\<\
NB: Do not use RelabelIndices on the resulting expression, since it will \
assume 3 is a dummy index!\
\>", "Text",ExpressionUUID->"5073dd2c-43cb-439a-9eee-2eae10766fd8"]
}, Open  ]]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Our [2506.05201] results", "Section",ExpressionUUID->"9ce1ef0d-1797-4c9a-ba7e-1fa3526b2b69"],

Cell[CellGroupData[{

Cell["Determine our full results for the Higgs quartic", "Subsection",ExpressionUUID->"47ccbdfe-00f3-46b3-bf68-0723a5582c2c"],

Cell[TextData[{
 "We set the SMEFT Higgs mass parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    SuperscriptBox["H", "2"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e581f606-431c-4d7f-96d7-c0f5c2900b2c"],
 " to zero here, which corresponds to dropping the d=6 corrections ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalO]", "(", 
     FractionBox[
      TemplateBox[{"c", 
        SuperscriptBox["H", "2"], "2"},
       "Subsuperscript"], 
      TemplateBox[{"m", "\[CapitalPhi]", "2"},
       "Subsuperscript"]], ")"}], "=", 
    RowBox[{"\[ScriptCapitalO]", "(", 
     FractionBox[
      TemplateBox[{"M", "H", "2"},
       "Subsuperscript"], 
      TemplateBox[{"m", "\[CapitalPhi]", "2"},
       "Subsuperscript"]], ")"}], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00a3610e-663e-4a3d-8190-95f0dd71017a"],
 " to the quartic which have not been computed by \
https://arxiv.org/abs/1407.4081v2."
}], "Text",ExpressionUUID->"9a66faee-6fbc-488d-be14-4e28ad0785f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lambda4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]", "[", "]"}], "/.", "mc"}], "/.", 
    RowBox[{
     RowBox[{"Coupling", "[", 
      RowBox[{"cH2", ",", "___"}], "]"}], "->", "0"}]}]}], ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"318fd69d-35bb-43c9-937a-a47d7a30dc7f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Mapping notation", "Subsection",ExpressionUUID->"cbd177a0-8edd-46d0-a07c-36ff358552a0"],

Cell[CellGroupData[{

Cell["\<\
Replacement rule for changing to GUT normalization of hypercharge coupling\
\>", "Subsubsection",ExpressionUUID->"9f9eb84e-4640-4f83-921e-f9ece89e0920"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "2"], "=", 
    SqrtBox[
     FractionBox["3", "5"]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2500f8bc-439e-4f3f-afad-b6c5c8197a19"],
 Cell[BoxData[
  FormBox[
   TemplateBox[{"g", "2", "GUT"},
    "Subsuperscript"], TraditionalForm]],ExpressionUUID->
  "a5d2888e-464d-41b1-915f-c2097b87e2dc"]
}], "Text",ExpressionUUID->"4247d601-c61f-4f0a-b7ff-83b362d62524"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GUTnorm", "=", 
   RowBox[{
    RowBox[{"cB2", "[", "]"}], "->", 
    RowBox[{
     SqrtBox[
      FractionBox["3", "5"]], 
     RowBox[{"cB2", "[", "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"56aa7919-22e0-4f43-94d8-a68a1202403c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Replacement rule for changing to Yukawa and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84359253-1d62-4cbc-8223-46acd5230120"],
 "-term notation of 1407.4081"
}], "Subsubsection",ExpressionUUID->"8deab73b-325e-4409-b394-eb4006fc6e62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TOPterms", "=", 
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"cHqu", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      RowBox[{"gt", "[", "]"}]}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{"au", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      RowBox[{
       FractionBox[
        RowBox[{"gt", "[", "]"}], 
        RowBox[{"s\[Gamma]", "[", "]"}]], 
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           RowBox[{"mqt", "[", "3", "]"}], 
           RowBox[{"mut", "[", "3", "]"}], 
           RowBox[{"Xtt", "[", "]"}]}]], "+", 
         RowBox[{
          RowBox[{"\[Mu]t", "[", "]"}], 
          FractionBox[
           RowBox[{"c\[Gamma]", "[", "]"}], 
           RowBox[{"s\[Gamma]", "[", "]"}]]}]}], ")"}]}]}]}], "\n", "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"6b418dec-397f-4a40-988e-af411e17ddc2"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "Take the limit of only keeping one-loop top Yukawas and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cedab3f8-5245-4c3a-a218-c84ce0932bac"],
 "-terms"
}], "Subsection",ExpressionUUID->"f88ed8c0-4c12-4b30-964a-3937fee25560"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lambdaTOP", "=", 
   RowBox[{"YukawaLimit", "[", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{"lambda4", ",", 
      RowBox[{"{", 
       RowBox[{"hbar", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"54b8d31c-976d-4f9a-9d53-df6e73071c3f"]
