Cell["\<\
The remaining expression is not vanishing due to trigonometric identities not \
being used, and because the different logarithms have to be combined \
together. Applying these manipulations, we find:\
\>", "Text",ExpressionUUID->"407efbf5-d894-4115-9a00-0db18294aa6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "split", " ", "up", " ", "the", " ", "logarithms", " ", "for", " ", 
    "better", " ", "simplifications", " ", "in", " ", "Mathematica"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]\[Lambda]", "=", 
     RowBox[{"FunctionExpand", "[", 
      RowBox[{"\[Lambda]diff", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"m1", "[", "]"}], ">", "0"}], "&&", 
        RowBox[{
         RowBox[{"m2", "[", "]"}], ">", "0"}], "&&", 
        RowBox[{
         RowBox[{"\[Mu]t", "[", "]"}], ">", "0"}], "&&", 
        RowBox[{"\[Mu]bar2", ">", "0"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"\[CapitalDelta]\[Lambda]", "=", 
    RowBox[{
     RowBox[{"TrigReduce", "[", 
      RowBox[{"\[CapitalDelta]\[Lambda]", "/.", "replTrig"}], "]"}], "//", 
     "NiceForm"}]}]}]}]], "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"8fb96a8c-5890-4fa3-914a-2baebfbede73"],

