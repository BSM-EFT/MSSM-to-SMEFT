Cell[BoxData[{
 RowBox[{
  RowBox[{"yukMatching", " ", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHqd", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], "\[Rule]",
       " ", 
