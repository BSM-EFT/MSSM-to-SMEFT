Cell[CellGroupData[{

Cell["Substitutions for the effective Yukawa and Gauge couplings", \
"Subsubsection",
 CellChangeTimes->{{3.9758740210912867`*^9, 3.9758740385585213`*^9}, {
  3.975874669007449*^9, 
  3.975874669776335*^9}},ExpressionUUID->"e9360b51-d8a2-4729-b07d-\
51f9a0c43cca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"yukMatching", " ", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHqd", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
      "\[Rule]", " ", 
      RowBox[{"Coupling", "[", 
       RowBox[{"Yd", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}]}], 
     ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHle", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
      "\[Rule]", " ", "0"}], ",", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHqu", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
      "\[Rule]", " ", 
      RowBox[{"Coupling", "[", 
       RowBox[{"Yu", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], 
       "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaugeMatching", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cG2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}], "->", 
      RowBox[{"Coupling", "[", 
       RowBox[{"g3", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cB2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}], "->", 
      RowBox[{"Coupling", "[", 
       RowBox[{"g1", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cW2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}], "->", 
      RowBox[{"Coupling", "[", 
       RowBox[{"g2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.975929030176346*^9, 3.975929036313245*^9}, {
  3.975932533537404*^9, 3.975932545724451*^9}, {3.975932985642088*^9, 
  3.97593299058388*^9}, {3.975933466402503*^9, 3.975933472688734*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"db7f57e8-103d-4fd9-9d96-e34521cc4e6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define couplings used in 1703.08166", "Subsubsection",
 CellChangeTimes->{{3.9758723026565723`*^9, 3.975872304039711*^9}, {
  3.9758725475910873`*^9, 
  3.975872557424542*^9}},ExpressionUUID->"74b5e3a6-7eec-421e-a3a9-\
43bbbed19e47"],

Cell[BoxData[{
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"xQ", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(x\), \(Q\)]\)\>\""}]}],
   "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"xU", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(x\), \(U\)]\)\>\""}]}],
   "]"}], "\n", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"Xt", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(X\), \(t\)]\)\>\""}]}],
   "]"}], "\[IndentingNewLine]", 
 RowBox[{"DefineCoupling", "[", 
  RowBox[{"gt", ",", 
   RowBox[{"SelfConjugate", "->", "True"}], ",", 
   RowBox[{"NiceForm", "->", "\"\<\!\(\*SubscriptBox[\(g\), \(t\)]\)\>\""}]}],
   "]"}]}], "Input",
 CellChangeTimes->{{3.975872865668909*^9, 3.975872910997654*^9}, {
  3.975874143618286*^9, 3.975874156695649*^9}, {3.975933289061269*^9, 
