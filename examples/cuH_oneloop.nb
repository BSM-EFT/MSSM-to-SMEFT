           RowBox[{
           "NiceForm", "->", 
            "\"\<\!\(\*TagBox[SubsuperscriptBox[\\\"M\\\", \\\"H\\\", \\\"2\\\
\"],DisplayForm]\)\>\""}]}], "}"}]}], "\[IndentingNewLine]", "\t", "}"}]}]}], 
     "\[IndentingNewLine]", "]"}], "/.", 
    RowBox[{
     RowBox[{"MH2", "[", "]"}], "->", 
     RowBox[{"-", 
      RowBox[{"MH2", "[", "]"}]}]}]}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "flip", " ", "sign", " ", "of", " ", "the", " ", "Higgs", " ", "mass"}], 
   " ", "*)"}], ";"}]], "Input",
