Cell[CellGroupData[{

Cell["Mapping rule for these new couplings", "Subsubsection",ExpressionUUID->"00f52e5b-9b83-4932-948c-1d4e0b7972f2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mapNotation", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Yu", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      RowBox[{"-", 
       RowBox[{"gt", "[", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"mqt", "[", "3", "]"}], "->", 
      RowBox[{
       RowBox[{"m3", "[", "]"}], "*", 
       RowBox[{"xQ", "[", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"mut", "[", "3", "]"}], "->", 
      RowBox[{
       RowBox[{"m3", "[", "]"}], "*", 
       RowBox[{"xU", "[", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"au", "[", 
       RowBox[{"3", ",", "3"}], "]"}], "->", 
      RowBox[{
       FractionBox[
        RowBox[{"-", 
         RowBox[{"gt", "[", "]"}]}], 
        RowBox[{"s\[Gamma]", "[", "]"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Xt", "[", "]"}], "+", 
         RowBox[{
          RowBox[{"\[Mu]t", "[", "]"}], 
          FractionBox[
           RowBox[{"c\[Gamma]", "[", "]"}], 
           RowBox[{"s\[Gamma]", "[", "]"}]]}]}], ")"}]}]}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9758731737959642`*^9, 3.9758732393536253`*^9}, {
   3.975873285164888*^9, 3.9758733164536753`*^9}, {3.9758735990230303`*^9, 
   3.975873638181522*^9}, {3.975874160226622*^9, 3.9758741817584467`*^9}, {
   3.975931570183049*^9, 3.975931572838204*^9}, {3.9759316908332233`*^9, 
   3.975931696621296*^9}, 3.975932552357965*^9, 3.975932618259351*^9, {
   3.975932819686359*^9, 3.975932820011715*^9}, {3.975932852563386*^9, 
   3.975932855550186*^9}, {3.975932903665544*^9, 3.975932919089438*^9}, {
   3.975933001633979*^9, 3.9759330025827923`*^9}, {3.975933333633972*^9, 
   3.975933333986155*^9}, {3.9759335122586327`*^9, 3.975933513260578*^9}, {
   3.9759335527850246`*^9, 3.97593355918505*^9}, {3.975933638768524*^9, 
   3.975933641448616*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"d710639c-7154-45a7-a9ec-26dba8d0a8e7"],

Cell[TextData[{
 "Note the \[OpenCurlyDoubleQuote]-\[CloseCurlyDoubleQuote] sign in the \
relation between the top Yukawa coupling in our convention (Yu[3,3]) and the \
one defined in 1703.08166. This can be discerned by comparing the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalL]", "SM"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a7251792-cd6e-4234-babd-07abfc8a23f5"],
 " loaded above and the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalL]", "SM"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e475284-1109-4b8d-887e-686bb558ad4c"],
 " defined in Eq. (17) of 1703.08166 or by comparing the tree-level matching \
condition for ",
 Cell[BoxData[
  SuperscriptBox[
   SubscriptBox["c", "t"], "tree"]],ExpressionUUID->
  "49c795d5-f079-4783-b1e2-7c8b95253536"],
 " (Eq. 18 in 1703.08166) with the result for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "uH"], " "}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0364a947-3b60-41c3-a153-ebe90d12b4d2"],
 "in Eq. (5.5) of 2506.05201 (our work)."
}], "Text",
 CellChangeTimes->{{3.975873434808083*^9, 3.975873445163439*^9}, {
  3.975936913730534*^9, 
  3.975937246851749*^9}},ExpressionUUID->"9f48db02-f086-42ef-9eb5-\
c2952985f383"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wilson coefficient result", "Subsection",
 CellChangeTimes->{
  3.975873430493129*^9},ExpressionUUID->"8d36668a-64f9-4e45-b4fb-\
6c683173bcb9"],

Cell[TextData[{
 "We consider the Warsaw basis Wilson coefficient ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalC]", "uH"], TraditionalForm]],ExpressionUUID->
  "8a6c2803-242d-464e-b749-6a97138002ed"],
 " for comparison. "
}], "Text",
 CellChangeTimes->{{3.975873434808083*^9, 3.975873445163439*^9}, {
  3.975936913730534*^9, 
  3.975936914480752*^9}},ExpressionUUID->"5f11bdc3-088d-4a1d-b753-\
f0d528af88a5"],

Cell[TextData[{
 "We start with our matching conditions, remove all loop functions (LF) that \
depend on the masses that have been set to \[Infinity] by \
https://arxiv.org/pdf/1703.08166, and neglect the Yukawas and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "789c9285-10c3-4540-94e6-d1821aa7495c"],
 "-terms of the down-type squarks."
}], "Text",
 CellChangeTimes->{{3.9758734496152277`*^9, 
  3.975873477674934*^9}},ExpressionUUID->"c9b82dbb-2a2a-451c-938c-\
2c0d61bf37ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ReduceMatchingConditions", "[", "wc_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "expr", "}"}], ",", "\n", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{"apply", " ", "matching", " ", "condition"}], " ", "*)"}], "\n",
      "\t", 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{"wc", "/.", "mc"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "replace", " ", "effective", " ", "Yukawa", " ", "and", " ", "gauge", 
        " ", "couplings"}], " ", "*)"}], "\[IndentingNewLine]", " ", 
      RowBox[{"expr", " ", "=", " ", 
       RowBox[{
        RowBox[{"expr", "/.", "yukMatching"}], "/.", "gaugeMatching"}]}], ";",
       "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"neglect", " ", "down"}], "-", 
        RowBox[{"type", " ", "Yukawa", " ", "and", " ", "a"}], "-", "terms"}],
        " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"Coupling", "[", 
          RowBox[{
           RowBox[{"Yd", "|", "ad"}], ",", "___"}], "]"}], "->", "0"}]}]}], 
      ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Set", " ", "all", " ", "loop", " ", "functions", " ", "to", " ", 
        "zero", " ", "that", " ", "depend", " ", "on", " ", "mass", " ", "of",
         " ", "particles", " ", "that", " ", "are", " ", "ignored", " ", 
        "here"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{
          RowBox[{"LF", "[", "arg___", "]"}], "/;", 
          RowBox[{"!", 
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "arg", "}"}], ",", "neglectedMassPattern", ",", 
             "All"}], "]"}]}]}], "->", "0"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"due", " ", "to", " ", "its", " ", "non"}], "-", 
         RowBox[{"vanishing", " ", "tree"}], "-", 
         RowBox[{"level", " ", "contribution"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "heavy", " ", "Higgs", " ", "can", " ", "contribute", 
          " ", "to", " ", "the", " ", "one"}], "-", 
         RowBox[{
         "loop", " ", "matching", " ", "conditions", " ", "also", " ", 
          "through", " ", "external", " ", "legs", " ", "with", " ", "EOM", 
          " ", "insertions", " ", "instead", " ", "of", " ", "only", " ", 
          RowBox[{"loops", ".", " ", "Hence"}], " ", "we", " ", "have", " ", 
          "to", " ", "set", " ", "its", " ", "mass", " ", "to", " ", 
          RowBox[{"\[Infinity]", "."}]}]}]}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"Limit", "[", 
        RowBox[{"expr", ",", 
         RowBox[{
          RowBox[{"m\[CapitalPhi]", "[", "]"}], "->", "\[Infinity]"}]}], 
        "]"}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "set", " ", "all", " ", "remeining", " ", "flavor", " ", "indices", 
        " ", "to", " ", "the", " ", "third", " ", "generation"}], " ", "*)"}],
       "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"_", ",", "Flavor"}], "]"}], "->", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "remove", " ", "the", " ", "FlavorSum", " ", "object", " ", 
        "introduced", " ", "by", " ", "Matchete"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{"_FlavorSum", "->", "1"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"map", " ", "to", " ", "the", " ", "notation", " ", 
        RowBox[{"of", " ", "[", "1703.08166", "]"}]}], " ", "*)"}], "\n", 
      "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "//.", "mapNotation"}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{
       "set", " ", "the", " ", "remaining", " ", "couplings", " ", 
        "proportional", " ", "to", " ", "the", " ", "Higgsino", " ", "mass", 
        " ", "to", " ", "zero"}], " ", "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{"expr", "/.", 
        RowBox[{
         RowBox[{"\[Mu]t", "[", "]"}], "->", "0"}]}]}], ";", "\n", "\t", 
      RowBox[{"(*", " ", 
       RowBox[{"evaluate", " ", "all", " ", "loop", " ", "functions"}], " ", 
       "*)"}], "\n", "\t", 
      RowBox[{"expr", "=", 
       RowBox[{
        RowBox[{"EvaluateLoopFunctions", "[", "expr", "]"}], "/.", 
        RowBox[{"hbar", "->", 
         FractionBox["1", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"4", "Pi"}], ")"}], "2"]]}]}]}]}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.975874061370075*^9, 3.975874125887464*^9}, 
   3.9758742835364857`*^9, 3.97593257090633*^9, {3.975932993827857*^9, 
   3.975932994757375*^9}, {3.975933520543736*^9, 3.975933521386241*^9}, {
   3.975937388406625*^9, 3.975937433718248*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"318679cf-1427-4d04-bf86-3f351c3cc17e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalC]uH", "=", 
   RowBox[{"ReduceMatchingConditions", "[", 
    RowBox[{"cuH", "[", 
     RowBox[{"p", ",", "r"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.975873498173357*^9, 3.975873501046986*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"fee5aaa4-2f92-475e-8330-114d65ea4c9c"],

