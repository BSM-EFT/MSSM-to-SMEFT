    3.975929573878108*^9}, {3.975929755184227*^9, 3.975929764237356*^9}, {
    3.9759298087702513`*^9, 3.975929840446023*^9}, {3.9759299265389423`*^9, 
    3.975929933205312*^9}, 3.9759300704698772`*^9, 3.975930416173682*^9},
  ExpressionUUID->"b1b9c5b1-fb40-4ae6-a0da-c715610e6cdf"],
 "):"
}], "Text",
 CellChangeTimes->{
  3.975873533018249*^9, {3.9759299618638763`*^9, 3.9759299774710817`*^9}, {
   3.9759300242738447`*^9, 3.9759300349354963`*^9}, {3.9759304376702833`*^9, 
   3.975930464460513*^9}},ExpressionUUID->"3986f968-95d4-476f-82b4-\
b4275603600b"],

Cell[CellGroupData[{

