Cell[BoxData[
 RowBox[{
  RowBox[{"FilterSquarkTerms", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "newExpr", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Initial", " ", "simplifications"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"newExpr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"expr", "/.", "MatchingCondition"}], "/.", 
            "symbolRules"}], "/.", 
           RowBox[{
            RowBox[{"Coupling", "[", 
             RowBox[{"x_", ",", 
              RowBox[{"{", "}"}], ",", "0"}], "]"}], ":>", "x"}]}], "/.", 
          RowBox[{
           RowBox[{"Coupling", "[", 
            RowBox[{"x_", ",", 
             RowBox[{"{", 
              RowBox[{"Index", "[", 
               RowBox[{"y_", ",", "Flavor"}], "]"}], "}"}], ",", "0"}], "]"}],
            ":>", 
           RowBox[{"x", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "/.", 
         RowBox[{
          RowBox[{"Coupling", "[", 
           RowBox[{"x_", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Index", "[", 
               RowBox[{"y_", ",", "Flavor"}], "]"}], ",", 
              RowBox[{"Index", "[", 
               RowBox[{"z_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], 
           "]"}], ":>", 
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "3"}], "]"}], "]"}]}]}], "/.", 
        RowBox[{
         RowBox[{"FlavorSum", "[", "_", "]"}], ":>", "1"}]}], "//", 
       "EvaluateLoopFunctions"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Keep", " ", "only", " ", "terms", " ", "with", " ", "masses", " ", 
       "specified", " ", "in", " ", "the", " ", "mass", " ", "list"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newExpr", "=", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"List", "@@", "newExpr"}], ",", 
         RowBox[{
          RowBox[{"ContainsAny", "[", 
           RowBox[{
            RowBox[{"Variables", "[", 
             RowBox[{"#", "/.", 
              RowBox[{
               RowBox[{"Log", "[", "x__", "]"}], ":>", "x"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"mut3", ",", "mdt3", ",", "mqt3"}], "}"}]}], "]"}], 
          "&"}]}], "]"}], "//", "Total"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
