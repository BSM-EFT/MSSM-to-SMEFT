Cell[CellGroupData[{

Cell["Remove coefficients with leptons or Higgs", "Subsection",
 CellChangeTimes->{{3.954514321721031*^9, 3.9545143403785763`*^9}, {
  3.954555908510151*^9, 
  3.954555908667533*^9}},ExpressionUUID->"f346ca86-96dd-4c92-904e-\
ebfd2ba876de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatchingConditionQ", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"MatchingCondition", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"!", 
        RowBox[{"StringMatchQ", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Coupling", "[", 
                RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], "->", "a"}], 
              "}"}]}], ")"}], "]"}], ",", 
          RowBox[{"Alternatives", "[", 
           
           RowBox[{"\"\<*e*\>\"", ",", "\"\<*l*\>\"", ",", "\"\<*H*\>\"", 
            ",", "\"\<*B*\>\"", ",", "\"\<*G2*\>\"", ",", "\"\<*\[Mu]2*\>\"", 
            ",", "\"\<*\[Lambda]*\>\"", ",", "\"\<*g2*\>\"", 
            ",", "\"\<*g1*\>\"", ",", "\"\<*g3*\>\"", ",", "\"\<*cW2*\>\""}], 
           "]"}]}], "]"}]}], ")"}], "&"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954514346539353*^9, 3.954514352770363*^9}, {
  3.954515909055184*^9, 3.954515909912241*^9}, {3.954516136838204*^9, 
