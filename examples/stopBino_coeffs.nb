Cell[CellGroupData[{

Cell[TextData[{
 "Lowest order matching condition for the Yukawas (Yu,Yd and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "i"], TraditionalForm]],ExpressionUUID->
  "d9b01f24-3425-48d0-8d3e-f9096c6e2dbd"],
 " are the SMEFT couplings)"
}], "Subsection",
 CellChangeTimes->{{3.948792900742152*^9, 3.948792927844632*^9}, {
  3.950885658889543*^9, 
  3.9508856763006287`*^9}},ExpressionUUID->"da134318-356c-4677-b7cc-\
086946a53376"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"yukMatching", " ", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHqd", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], "\[Rule]",
       " ", "0"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHle", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], "\[Rule]",
       " ", "0"}], ",", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cHqu", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], "\[Rule]",
       " ", 
      RowBox[{"Coupling", "[", 
       RowBox[{"Yu", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Index", "[", 
           RowBox[{"i", ",", "Flavor"}], "]"}], ",", 
          RowBox[{"Index", "[", 
           RowBox[{"j", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], 
       "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaugeMatching", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cG2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}], "->", 
      RowBox[{"Coupling", "[", 
       RowBox[{"g3", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Coupling", "[", 
       RowBox[{"cB2", ",", 
        RowBox[{"{", "}"}], ",", "0"}], "]"}], "->", 
      RowBox[{"Coupling", "[", 
       RowBox[{"g1", ",", 
