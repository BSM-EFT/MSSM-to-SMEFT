Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"heavyExpand", "[", "c_", "]"}], ":=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"c", "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FlavorSum", "[", "a__", "]"}], "->", "1"}], ",", 
            RowBox[{"d$$1", "->", "3"}]}], "}"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Coupling", "[", 
            RowBox[{"mut", ",", 
             RowBox[{"{", 
              RowBox[{"Index", "[", 
               RowBox[{"a_", ",", "Flavor"}], "]"}], "}"}], ",", "0"}], "]"}],
            "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"a", "==", "3"}], ",", 
             SubscriptBox["m", "tR"], ",", "M"}], "]"}]}], "}"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Delta", "[", 
            RowBox[{
             RowBox[{"Index", "[", 
              RowBox[{"a_", ",", "Flavor"}], "]"}], ",", 
             RowBox[{"Index", "[", 
              RowBox[{"b_", ",", "Flavor"}], "]"}]}], "]"}], "^", "n_"}], "->", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"a", ",", "b"}], "]"}]}], "}"}]}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"M", ",", "Infinity", ",", "0"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9545769799871683`*^9, 3.95457707121416*^9}},
