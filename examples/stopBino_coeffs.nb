Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"coeffs", " ", "=", " ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"Coupling", "[", 
      RowBox[{"cuG", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cG", ",", 
       RowBox[{"{", "}"}], ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cqu8", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cqu8", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cqq1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cuu", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"a2", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cqd1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Coupling", "[", 
      RowBox[{"cqu1", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"1", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
         RowBox[{"Index", "[", 
          RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "coeffs", "]"}]}], ",", 
   RowBox[{"++", "i"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", 
     RowBox[{"coeffs", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cval", "=", 
     RowBox[{"c", "/.", "matchSimp7"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cval", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{"cval", ",", "a2", ",", "Infinity"}], "]"}], ",", "cval", ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"cval", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Coupling", "[", 
                 RowBox[{"mut", ",", 
                  RowBox[{"{", 
                   RowBox[{"Index", "[", 
                    RowBox[{"3", ",", "Flavor"}], "]"}], "}"}], ",", "0"}], 
                 "]"}], "->", 
                SubscriptBox["m", "tR"]}], ",", 
               RowBox[{
                RowBox[{"Coupling", "[", 
                 RowBox[{"mut", ",", 
                  RowBox[{"{", 
                   RowBox[{"Index", "[", 
                    RowBox[{"a2", ",", "Flavor"}], "]"}], "}"}], ",", "0"}], 
                 "]"}], "->", 
                SubscriptBox["M", "tR"]}]}], "}"}]}], "/.", 
            RowBox[{"{", 
             RowBox[{"a2", "->", "3"}], "}"}]}], ")"}], ",", 
          RowBox[{
           SubscriptBox["M", "tR"], "->", 
           SubscriptBox["m", "tR"]}]}], "]"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cval", " ", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"heavyExpand", "[", " ", "cval", "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"m1", "[", "]"}], "->", 
           RowBox[{
            SqrtBox["x"], " ", 
            SubscriptBox["m", "tR"]}]}], ",", 
          RowBox[{
           RowBox[{"g1", "[", "]"}], "->", 
           RowBox[{
            FractionBox["3", 
             RowBox[{"2", 
              SqrtBox["2"]}]], 
            SubscriptBox["y", "DM"]}]}], ",", 
          RowBox[{
           RowBox[{"Coupling", "[", 
            RowBox[{"Yu", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Index", "[", 
                RowBox[{"3", ",", "Flavor"}], "]"}], ",", 
               RowBox[{"Index", "[", 
                RowBox[{"3", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], 
            "]"}], "->", 
           SubscriptBox["Y", "t"]}]}], "}"}]}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["m", "tR"], ">", "0"}], ",", 
          RowBox[{"x", "<", "1"}], ",", 
          RowBox[{"x", ">", "0"}]}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"cval", " ", "=", " ", 
     RowBox[{"Collect", "[", 
      RowBox[{
       RowBox[{"Expand", "[", "cval", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["y", "DM"], ",", 
         SubscriptBox["Y", "t"], ",", 
         SubscriptBox["m", "tR"]}], "}"}], ",", "Simplify"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{
      RowBox[{"NiceForm", "[", 
       RowBox[{"c", "/.", 
        RowBox[{"{", 
         RowBox[{"a2", "->", "3"}], "}"}]}], "]"}], ",", "\"\< = \>\"", ",", 
      RowBox[{"NiceForm", "[", "cval", "]"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.954580557748143*^9, 3.9545807511198673`*^9}, {
