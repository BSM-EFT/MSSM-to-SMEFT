\\\\right)*\\\\log(\\\\frac{m_{Q3}^2}{\\\\mu^2})  + 3*g_t^2*  \\\\left(g_t^2 \
+ \\\\frac{2}{5} g_1^2  \\\\cos(2 \\\\beta) \\\\right)* \
\\\\log(\\\\frac{m_{U3}^2}{\\\\mu^2})     +\\\\frac{ \\\\cos^2(2 \
\\\\beta)}{300}\\\\,  \\\\left(3 \\\\left(g_1^4+25 g_2^4\\\\right)   \\\\log(\
\\\\frac{m_{Q_i}^2}{\\\\mu^2})  +24 g_1^4 \\\\log( \
\\\\frac{m_{U_i}^2}{\\\\mu^2})   +6 g_1^4 \
\\\\log(\\\\frac{m_{Di}^2}{\\\\mu^2})    + \\\\left(9 g_1^4+25 \
g_2^4\\\\right) \\\\log(\\\\frac{m_{L_i}^2}{\\\\mu^2})     +18 g_1^4 \\\\log(\
\\\\frac{m_{E_i}^2}{\\\\mu^2})  \\\\right)   +\\\\frac{1}{4800}  \\\\left(261 \
g_1^4+630 g_1^2 g_2^2  +1325  g_ 2^4  - 4 \\\\cos(4 \\\\beta)  \\\\left(9 \
g_1^4+90 g_1^2 g_2^2+175  g_2^4\\\\right)   -9 \\\\cos(8\\\\beta)  \\\\left(3 \
g_1^2+5 g_2^2\\\\right)^2  \\\\right)   \\\\log(\\\\frac{m_{A}^2}{\\\\mu^2}) \
-\\\\frac{3}{16} \\\\left(\\\\frac{3}{5} g_1^2 +  g_2^2\\\\right)^2   \\\\sin \
^2(4 \\\\beta)    +6*g_t^4 * X_{t} * \\\\left( F_1\\\\left(x_{QU}\\\\right)   \
    -\\\\frac{X_{t}}{12} F_2\\\\left(x_{QU}\\\\right)\\\\right)   + \
\\\\frac{3}{4} g_t^2 X_{t} \\\\cos(2\\\\beta) \\\\left(\\\\frac{3}{5} g_1^2   \
F_3 \\\\left(x_{QU}\\\\right)   + g_2^2 F_4 \\\\left(x_{QU}\\\\right) \
\\\\right) -\\\\frac14  g_t^2 X_{t} \\\\cos^2(2\\\\beta)   \\\\left( \
\\\\frac{3}{5} g_1^2 +g_2^2 \\\\right) F_5\\\\left(x_{QU} \\\\right)\>\"", ",",
     "TeXForm"}], "]"}]}]], "Input",
