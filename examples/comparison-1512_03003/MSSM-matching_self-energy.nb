Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalL]MSSM", " ", "=", " ", 
    RowBox[{"LoadModel", "@", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParentDirectory", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", "2"}], "]"}], ",", 
        "\"\<matching\>\"", ",", "\"\<MSSM.m\>\""}], "}"}], "]"}]}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{"change", " ", "path", " ", "if", " ", "required"}], " ", 
   "*)"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"977db4fd-231e-452b-b2f5-c24f7542a422"],

