Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stopsGaugeOnly", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Index", "[", 
        RowBox[{"i_", ",", "Flavor"}], "]"}], "->", 
