Cell[CellGroupData[{

Cell["\<\
Keep only the contributions from left and right-handed stops:\
\>", "Section",
 CellChangeTimes->{{3.954477784846281*^9, 
  3.954477824572947*^9}},ExpressionUUID->"8e610ebe-bbac-484a-8b42-\
eead525eb7d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stopsGaugeOnly", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Index", "[", 
        RowBox[{"i_", ",", "Flavor"}], "]"}], "->", 
       RowBox[{"Index", "[", 
        RowBox[{"3", ",", "Flavor"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{"yd", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
       "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{"ye", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
