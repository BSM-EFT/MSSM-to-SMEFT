   "Write", " ", "results", " ", "in", " ", "terms", " ", "of", " ", "SM", " ",
     "Yukawa", " ", "couplings"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yukMatching", " ", "=", " ", 
    RowBox[{"{", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{"cHqd", ",", 
         RowBox[{"{", 
