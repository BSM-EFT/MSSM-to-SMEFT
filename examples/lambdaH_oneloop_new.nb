       RowBox[{"Coupling", "[", 
        RowBox[{"yd", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
       "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{"ye", ",", 
