          RowBox[{
           RowBox[{"Index", "[", 
            RowBox[{"i_", ",", "Flavor"}], "]"}], ",", 
           RowBox[{"Index", "[", 
            RowBox[{"j_", ",", "Flavor"}], "]"}]}], "}"}], ",", "0"}], "]"}], 
       "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"ad", "[", 
        RowBox[{"i_", ",", "j_"}], "]"}], "\[Rule]", "0"}], ",", 
      RowBox[{
       RowBox[{"ae", "[", 
        RowBox[{"i_", ",", "j_"}], "]"}], "\[Rule]", " ", "0"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
