Cell[BoxData[{
 RowBox[{
  RowBox[{"lH", "=", 
   RowBox[{
    RowBox[{"Coupling", "[", 
     RowBox[{"\[Lambda]", ",", 
      RowBox[{"{", "}"}], ",", "0"}], "]"}], "/.", "MatchingCondition"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lH", " ", "=", " ", 
    RowBox[{"lH", "-", 
     RowBox[{"(", 
      RowBox[{"lH", "/.", 
       RowBox[{"{", 
        RowBox[{"hbar", "->", "0"}], "}"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"keep", " ", "only", " ", "the", " ", "1"}], "-", 
    RowBox[{"loop", " ", "result"}]}], "*)"}]}]}], "Input",
