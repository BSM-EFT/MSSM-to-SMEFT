Cell[TextData[{
 "Trying to check the term proportional to Log[M2^2/\[Mu]bar^2]\n(should be \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"-", "2"}], "6"], 
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"2", "\[Beta]"}], ")"}], "^", "2"}], " ", 
    RowBox[{"g2", "^", "4"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"M2", "^", "2"}], "/", 
      RowBox[{"\[Mu]bar", "^", "2"}]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "207daea6-ea22-4572-9fd2-af2f311f3b6c"],
 " from Eq. 13 in 1407.4081)"
}], "Subsubsection",
